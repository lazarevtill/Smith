// A DS line icon (24x24 geometry, recolored via `stroke`). Pass an
// `Icons.<name>` as `source`.
export component Icon inherits Image {
    in property <length> size: 20px;
    in property <brush> stroke: Palette.text-body;
    width: root.size;
    height: root.size;
    colorize: root.stroke;
}
