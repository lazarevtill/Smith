// Smith — main chat window, framed in the Lazarev Cloud design system.
//
// Three panes: a near-black icon rail, a session list, and the conversation
// thread with a composer. Monochrome surfaces, a single red signal, sharp 4px
// corners. This is also the entry file the build script compiles, so it
// re-exports the settings and model-browser windows plus the shared globals.

import { LineEdit, ListView, ScrollView, Palette as StdPalette } from "std-widgets.slint";
import { SettingsView, McpItem, ScheduleItem, WatcherItem, MemoryItem, SkillItem, MethodItem, RecipeItem, DetectionItem } from "settings.slint";
import { ModelsView, ModelItem } from "models.slint";
import { AgentsView, AgentItem, SignalItem, LessonItem } from "agents.slint";
// TranscribeView/ArtifactsView are embedded inside ActivityView now (P4
// "Consolidate navigation"), not instantiated directly here — only their
// item struct types are needed at this level, to re-export for Rust.
import { TranscriptItem, FormatTab } from "transcribe.slint";
import { ArtifactItem } from "artifacts.slint";
import { ActivityView, ActivityItem } from "activity.slint";
import { Palette, SmithButton, RailButton, StatusPill, Avatar, Banner, EmptyState, CopyBlock, SmithRadio } from "theme.slint";
import { Icon, Icons } from "icons.slint";
import { AgentsAutonomyView } from "agents-autonomy.slint";

// Re-export so `slint::include_modules!()` exposes them to Rust.
export { ModelItem, AgentItem, SignalItem, LessonItem, McpItem, ScheduleItem, WatcherItem, MemoryItem, SkillItem, MethodItem, RecipeItem, DetectionItem, TranscriptItem, ArtifactItem, ActivityItem, Palette }

// A chat session shown in the sidebar.
export struct SessionItem {
    id: string,
    title: string,
    subtitle: string,
}

// One suggestion in the slash-command autocomplete popup (P4 "Wire the
// slash-command autocomplete popup" — mirrors `smith_core::slash::SlashCommand`,
// the matcher/parser/template-expander that was already built + unit-tested
// but had no UI consumer).
export struct SlashCommandItem {
    name: string,
    description: string,
}

// One rendered message in the transcript. `role` is "user" | "assistant" |
// "system" | "tool" (matches `smith_core::domain::MessageRole`).
// One rendered piece of a message: a fenced code block ("code"), a tool-call
// card ("tool"), a heading ("h1"/"h2"/"h3"), or CommonMark prose ("markdown"
// — bold/inline-code/links/ordered+unordered lists, rendered by the builtin
// `StyledText` element; see `bridge::segment_markdown`).
export struct MessageSegment {
    kind: string,
    lang: string,
    text: string,
    // Populated only for `kind == "markdown"` (native CommonMark styling —
    // bold, inline code, links, lists). Other kinds leave this at its
    // default and render `text` directly instead.
    styled: styled-text,
    // Populated only for `kind == "image"` (a generated-image bubble, P2
    // "render generated images inline"): the decoded pixel data, ready to
    // hand straight to an `Image` element. `text` carries the backing
    // artifact's id (for "open in Artifacts"/copy actions) rather than any
    // human-readable content.
    image: image,
}

export struct ChatMessage {
    // Stable message id (matches the persisted messages.id). Used to attach
    // interaction-feedback signals to the right message.
    id: string,
    role: string,
    text: string,
    // Optional model reasoning ("thinking"); rendered as a collapsible block.
    reasoning: string,
    // The message split into prose + code segments (DS MarkdownContent/CodeBlock).
    segments: [MessageSegment],
    // Generation stats (DS TokenMeter): e.g. "42 tok · 18 tok/s · 2.3s".
    stats: string,
    // In-session feedback the user gave on this message ("" | "thumbs_up" |
    // "thumbs_down"), so the chosen thumb renders active.
    feedback: string,
    // True while this message's text-to-speech playback is being synthesized
    // or played, so the speaker button can show a busy state and ignore
    // repeated clicks instead of queueing duplicate playback.
    speaking: bool,
    // Branch navigator (P0): this message's 1-based position among its
    // sibling forks (from a prior edit/regenerate), and the total sibling
    // count. `branch-count <= 1` means "no fork here" — the `‹ i/n ›`
    // switcher stays hidden. Only ever >1 on user turns (forks always land
    // on a user message; see `smith-ui::branches`).
    branch-index: int,
    branch-count: int,
}

// A setup/install row in the welcome wizard: title + status + an action button,
// plus an optional copyable manual command shown as a fallback.
component SetupRow inherits Rectangle {
    in property <string> title;
    in property <string> status;
    in property <string> action;
    in property <string> manual-command;
    in property <bool> enabled: true;
    callback act();
    callback copy-command(string);
    height: col.preferred-height;
    border-radius: Palette.radius;
    background: Palette.raised;
    border-width: 1px;
    border-color: Palette.border;
    col := VerticalLayout {
        padding: 12px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.title;
                    color: Palette.text-strong;
                    font-family: Palette.font-body;
                    font-size: 14px;
                    font-weight: 600;
                }
                Text {
                    text: root.status;
                    color: Palette.text-muted;
                    font-family: Palette.font-body;
                    font-size: 12px;
                    overflow: elide;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                SmithButton {
                    text: root.action;
                    kind: "secondary";
                    width: 140px;
                    enabled: root.enabled;
                    clicked => { root.act(); }
                }
            }
        }
        // Copyable manual command — the actionable fallback when the one-click
        // install can't run (per the "show the exact command" UX rule).
        if root.manual-command != "": VerticalLayout {
            spacing: 5px;
            Text {
                text: "Or run this manually:";
                color: Palette.text-subtle;
                font-family: Palette.font-mono;
                font-size: 10px;
                letter-spacing: 0.3px;
            }
            CopyBlock {
                value: root.manual-command;
                copy(v) => { root.copy-command(v); }
            }
        }
    }
}

// The assistant brand mark: a red disc holding the white Lazarev logomark
// (DS ChatMessage spec — the assistant turn leads with this 30×30 disc).
component AssistantMark inherits Rectangle {
    width: 30px;
    height: 30px;
    border-radius: 15px;
    background: Palette.red;
    Image {
        width: 26px;
        height: 26px;
        source: @image-url("../assets/icons/logomark.svg");
        colorize: Palette.white;
    }
}

// A single window-control button (minimize / maximize / close) for the custom
// frameless title bar. `danger` tints the hover red (used by close).
component WindowButton inherits Rectangle {
    in property <image> glyph;
    in property <bool> danger: false;
    callback clicked();
    width: 46px;
    height: 32px;
    background: ta.has-hover ? (root.danger ? Palette.red : Palette.hover) : transparent;
    animate background { duration: 100ms; }
    Image {
        width: 14px;
        height: 14px;
        source: root.glyph;
        colorize: (root.danger && ta.has-hover) ? Palette.white : Palette.text-subtle;
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Smith's own frameless title bar: a draggable strip + window controls. Shown
// only when `MainWindow.frameless` is on; the OS frame is hidden in that mode.
component TitleBar inherits Rectangle {
    callback minimize();
    callback maximize();
    callback close();
    callback drag();
    height: 38px;
    background: Palette.page;
    HorizontalLayout {
        padding-left: 12px;
        spacing: 8px;
        // The draggable region (everything but the buttons).
        drag-area := TouchArea {
            horizontal-stretch: 1;
            moved => {
                root.drag();
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                VerticalLayout {
                    alignment: center;
                    AssistantMark {
                        width: 20px;
                        height: 20px;
                        border-radius: 10px;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Smith";
                        color: Palette.text-strong;
                        font-size: 13px;
                        font-weight: 600;
                    }
                }
            }
        }
        WindowButton {
            glyph: Icons.minus;
            clicked => {
                root.minimize();
            }
        }
        WindowButton {
            glyph: Icons.square;
            clicked => {
                root.maximize();
            }
        }
        WindowButton {
            glyph: Icons.x;
            danger: true;
            clicked => {
                root.close();
            }
        }
    }
}

export component MainWindow inherits Window {
    title: "Smith";
    icon: @image-url("../assets/icon-256.png");
    preferred-width: 1280px;
    preferred-height: 720px;
    // Activity switches between its list and detail at compact widths.
    min-width: 960px;
    min-height: 540px;
    property <bool> compact-layout: false;
    changed width => {
        if root.compact-layout != (root.width < 1124px) {
            root.compact-layout = root.width < 1124px;
        }
    }
    background: Palette.page;
    // Give the keyboard-shortcut scope initial focus (native-feel shortcuts work
    // before the user clicks anything; clicking an input moves focus normally).
    forward-focus: kb;

    // Keep the std-widgets (LineEdit / TextEdit / ComboBox + their dropdown popups)
    // color scheme in lockstep with Smith's theme. Without this they follow the OS
    // scheme, so on the default light theme their text renders white-on-white
    // (invisible). `init` sets the initial value; `changed` follows live toggles.
    init => {
        StdPalette.color-scheme = Palette.dark ? ColorScheme.dark : ColorScheme.light;
    }
    property <bool> theme-is-dark: Palette.dark;
    changed theme-is-dark => {
        StdPalette.color-scheme = self.theme-is-dark ? ColorScheme.dark : ColorScheme.light;
    }

    // --- Data in -----------------------------------------------------------
    in property <[SessionItem]> sessions;
    // Session search (P4 "Session search in the chat sidebar"): filters
    // `sessions` by title/subtitle, case-insensitive. Rust re-derives
    // `sessions` (+ the id list it's paired with) on every keystroke from an
    // in-memory cache — no DB round-trip, so this stays instant.
    in-out property <string> session-query: "";
    callback filter-sessions(string);
    in property <[ChatMessage]> messages;
    in property <[string]> models;
    in property <string> active-model: "—";
    in property <string> server-address: "localhost:1337";
    // Real server health (P0 "honest status dot"), polled off a background
    // timer against the embedded server's own `/health` route — never
    // hardcoded. "online" | "degraded" | "offline"; "checking" briefly at
    // startup before the first probe completes.
    in property <string> server-status: "checking";
    in property <bool> streaming: false;
    // A code-block "save to disk" / session "export" write is in flight.
    // Single view-wide flags (mirrors `agent-saving`/`sandbox-provisioning`)
    // rather than per-row state — the write used to run inline on the UI
    // thread, which accidentally serialized rapid double-clicks; moving it
    // async removed that accidental protection, so these replace it with a
    // real one instead of leaving concurrent writes to the same path unguarded.
    in-out property <bool> code-block-saving: false;
    in-out property <bool> export-session-saving: false;
    in-out property <int> selected-session: 0;
    in-out property <string> composer-text;
    // Slash-command autocomplete (P4 "Wire the slash-command autocomplete
    // popup"): live suggestions for the `/token` currently being typed,
    // recomputed by Rust (`smith_core::slash::match_slash`) on every
    // keystroke via `changed composer-text` below. Empty = no popup.
    in property <[SlashCommandItem]> slash-matches: [];
    callback filter-slash(string);
    // Replace the composer with `/name ` (ready for the argument) and close
    // the popup — fired by clicking a suggestion or accepting it via Tab.
    callback pick-slash(string);
    changed composer-text => { root.filter-slash(root.composer-text); }
    // Which popup row is highlighted (keyboard-nav gap fix): Tab used to
    // always accept `slash-matches[0]` with no way to reach any other
    // suggestion without a mouse. Rust owns the index arithmetic
    // (`bridge::advance_slash_selection`, unit-tested) so `.slint` just
    // reports a direction; reset to `0` on every `filter-slash` re-run
    // since the match list is recomputed (and can shrink) on every
    // keystroke.
    in-out property <int> slash-selected: 0;
    callback slash-nav(int);
    // Name of the file attached to the next message ("" = none).
    in-out property <string> attachment-name: "";
    // Full path of the attached file (read on send); not shown directly.
    in-out property <string> attachment-path: "";
    // An artifact picked from the composer's Artifacts picker for the next
    // message (id + display title). Mutually exclusive with attachment-path/
    // attachment-name — picking one clears the other.
    in-out property <string> pending-artifact-id: "";
    in-out property <string> pending-artifact-title: "";
    // Set once picking a Transcript-kind artifact resolves what its summary
    // situation is — one of "" (not checked yet / nothing to show),
    // "generating" (no summary existed, one is being auto-created — the
    // pending-artifact chip shows this inline so the user knows why nothing
    // happened instantly), "ready" (a summary exists — either pre-existing
    // or just generated — the chip offers a "Full transcript / Summary"
    // choice), or "unavailable" (no summary, and none could be generated —
    // e.g. no model loaded). A single string rather than several bools so
    // the chip can never render two of these at once by accident.
    // `use-summary` defaults to false (attach the full transcript, matching
    // pre-existing behavior) and is read at send time — only meaningful
    // when the state is "ready".
    in-out property <string> pending-artifact-summary-state: "";
    in-out property <bool> pending-artifact-use-summary: false;
    // Whether the mic is currently capturing for voice input.
    in property <bool> recording: false;
    // Tool-mode toggle (P0): explicit composer control for whether a chat turn
    // routes through the tool-using agent loop. Deliberately separate from
    // `agent-tools` (the *Agents editor's* "Tools" capability checkbox, below)
    // — that field used to be silently reused for this, so opening/editing an
    // unrelated agent could flip live chat behavior. Defaults off: tool
    // execution has real side effects (shell/file, via the WSL2 sandbox), so
    // an explicit opt-in per session is the safer default.
    in-out property <bool> composer-tools: false;
    // Auto-scroll (P0): pinned to the transcript's bottom by default so a
    // streaming reply never scrolls out of view. `chat-scroll`'s own
    // `changed viewport-height` handler re-pins on every rendered-height
    // change (new message, streamed token growth, a code block/thinking
    // block expanding, …) while this stays true; its `scrolled` callback
    // (user drag/wheel input only — never our own programmatic writes)
    // flips it false unless the user scrolled back near the bottom
    // themselves. The "jump to latest" chip flips it back on. `in-out` (not
    // just internal) so Rust can re-pin when a fresh transcript loads
    // (switching sessions, starting a new one) — the user's scroll position
    // in a *previous* chat shouldn't carry over.
    in-out property <bool> pinned-to-bottom: true;
    // Transient status banner text (downloads, provisioning, …); "" hides it.
    in-out property <string> status-text: "";
    in property <[ModelItem]> download-items;
    callback dismiss-download(string);
    in-out property <length> model-anchor-x;
    in-out property <length> model-anchor-y;
    in-out property <length> artifact-anchor-x;
    in-out property <length> artifact-anchor-y;
    in property <bool> session-loading: false;
    in property <string> session-error: "";
    in property <string> chat-operation: "";
    in-out property <bool> editing-message: false;
    property <bool> can-send: !root.session-loading && root.session-error == "" && root.chat-operation == "";
    // Whether the model dropdown overlay is open.
    in-out property <bool> model-open: false;
    // Which center view is active: 0 = chat, 1 = models, 2 = settings.
    in-out property <int> active-view: 0;
    changed active-view => {
        root.model-open = false;
        root.artifact-picker-open = false;
    }
    // Active sub-section of the Agents & Autonomy view (0 = Agents, 1 = MCP,
    // 2 = Schedules, 3 = Watchers, 4 = Extensions). Exposed so the host can
    // deep-link and snapshots can drive it. Memory moved to the Activity
    // hub's own `activity-sub-view` (P4 "Consolidate navigation").
    in-out property <int> autonomy-sub-view: 0;
    // Which Extensions pane shows within sub-view 4: "skills" | "methods" |
    // "tools" (P4 "fold Skills/Methods/Tools-recipes into one Extensions tab").
    in-out property <string> autonomy-ext-tab: "skills";

    // --- Settings (mirror AppConfiguration) --------------------------------
    in property <[string]> appearance-modes: ["System", "Light", "Dark"];
    in-out property <string> appearance: "System";
    in-out property <bool> start-at-login: false;
    in-out property <bool> tray-only: false;
    in-out property <bool> telemetry-enabled: false;
    in-out property <string> collect-endpoint;
    in-out property <string> collect-token;
    in-out property <string> collect-error;
    in-out property <bool> crash-reporting-enabled: false;
    in-out property <string> port-text: "1337";
    in property <string> port-error: "";
    callback restart-now(string);
    // Set when the relaunch itself fails (e.g. the OS refuses to spawn a
    // second copy of the binary) — previously silent (only
    // `tracing::error!`-logged), so "Restart now" looked like a no-op. Split
    // per restart-requiring card (not one shared string) since Server tab's
    // Port and Network-exposure cards render simultaneously once its
    // "Advanced" disclosure is expanded — a shared string showed the wrong
    // card's error duplicated under both, and never cleared on navigating
    // to a different card entirely.
    in property <string> restart-error-port: "";
    in property <string> restart-error-network: "";
    in property <string> restart-error-execution-provider: "";
    in property <string> restart-error-computer-use: "";
    in property <string> restart-error-providers: "";
    in-out property <bool> expose-to-network: false;
    // Node identity + access key (P2 "Access key + node identity").
    in property <string> node-address: "";
    in property <string> node-access-key: "";
    in property <string> access-key-error: "";
    callback generate-access-key();
    in-out property <string> default-model: "";
    // Whether `default-model` is configured but no longer resolves against
    // the live model catalog (P4 "Models view clarity") — e.g. it was
    // deleted from the Models tab, or the models directory changed out from
    // under it. Recomputed by Rust after every download/delete/settings
    // change (`refresh_available_models` in smith-ui's lib.rs).
    in-out property <bool> default-model-missing: false;
    in-out property <string> models-dir: "";
    callback change-models-dir();
    in-out property <string> artifacts-dir: "";
    in-out property <string> artifacts-dir-status: "";
    in-out property <bool> artifacts-dir-busy: false;
    in-out property <bool> artifacts-dir-error: false;
    in-out property <float> artifacts-dir-progress: 0.0;
    // A folder has been picked but the move hasn't been confirmed yet — ""
    // means no pending pick. Two-step (pick, then confirm) because a
    // relocation physically moves every existing artifact, unlike the
    // models-dir picker's instant, low-risk pointer flip.
    in-out property <string> artifacts-dir-pending: "";
    in-out property <string> artifacts-dir-pending-free: "";
    in-out property <bool> artifacts-dir-pending-low-disk: false;
    callback change-artifacts-dir();
    callback confirm-artifacts-move();
    callback cancel-artifacts-move();
    in property <[string]> exec-providers: ["Auto", "DirectML", "CUDA", "OpenVINO (Intel)", "QNN (Qualcomm)", "Vitis AI (AMD)", "CPU"];
    in-out property <string> execution-provider: "Auto";
    in-out property <string> reasoning-effort: "Medium";
    in-out property <string> voice-language: "en";
    in-out property <bool> consolidate-enabled: true;
    in-out property <bool> reflect-enabled: false;
    in-out property <bool> soul-evolve-enabled: false;
    in-out property <bool> memory-summarizer-enabled: false;
    in property <string> metrics-summary;
    in property <[string]> metrics-rows;
    callback refresh-metrics();
    in property <string> app-version: "";
    in property <string> hardware-summary: "";
    in-out property <bool> diagnostics-exporting: false;
    callback export-diagnostics();
    in property <[string]> privacy-modes: ["Off", "Review", "Enforce"];
    in-out property <string> privacy-mode: "Review";
    in-out property <string> privacy-test-input;
    in property <[DetectionItem]> privacy-detections;
    in property <bool> privacy-tested: false;
    in property <[string]> computer-use-policies: ["Locked", "Read-only", "Assisted", "Full"];
    in-out property <string> computer-use-policy: "Read-only";
    // "What Smith learned" (P2): read-only per-agent learning panel.
    in property <[SignalItem]> agent-signals;
    in property <[LessonItem]> agent-lessons;
    in property <string> agent-soul-current: "";
    in property <string> agent-challenger-summary: "";
    in property <string> agent-evolve-state: "";
    in property <bool> agent-evolve-is-error: false;
    callback evolve-agent-now();
    in property <string> sandbox-status: "Checking…";
    in property <bool> sandbox-provisioning: false;
    in-out property <int> settings-tab: 0;
    in-out property <string> openai-key;
    in-out property <string> anthropic-key;
    in-out property <string> gemini-key;
    in-out property <string> openrouter-key;
    in-out property <string> lmstudio-key;
    in-out property <string> local-openai-endpoint;
    in-out property <string> local-openai-error;
    in-out property <string> winml-key;
    in-out property <string> winml-endpoint;
    in property <[McpItem]> mcp-providers;
    in-out property <string> mcp-name;
    in-out property <string> mcp-command;
    in-out property <string> mcp-args;
    in property <string> mcp-status: "";
    in property <bool> mcp-adding: false;
    in property <[string]> agent-names;
    in property <[ScheduleItem]> schedules;
    in-out property <string> sched-name;
    in-out property <string> sched-agent;
    in-out property <string> sched-cron;
    in-out property <string> sched-prompt;
    in property <string> sched-cron-error: "";
    in property <string> sched-next-fires: "";
    in property <string> sched-status: "";
    in property <bool> sched-adding: false;
    callback validate-cron(string);
    in property <[WatcherItem]> watchers;
    in-out property <string> watch-name;
    in-out property <string> watch-agent;
    in-out property <string> watch-path;
    in-out property <string> watch-kind: "Any";
    in-out property <bool> watch-recursive: true;
    in property <string> watch-status: "";
    in property <bool> watch-adding: false;
    in property <[MemoryItem]> memory-rows;
    in-out property <string> memory-query;
    in property <bool> memory-searching: false;
    in property <bool> memory-browsing: false;
    callback browse-memory();
    callback delete-memory(string);
    callback toggle-pin-memory(string);
    in property <[SkillItem]> skills;
    in-out property <string> skill-name;
    in-out property <string> skill-category;
    in-out property <string> skill-desc;
    in-out property <string> skill-instructions;
    in-out property <bool> skill-enabled: true;
    in property <string> skill-status: "";
    in property <bool> skill-adding: false;
    in property <[MethodItem]> methods;
    in-out property <string> method-name;
    in-out property <string> method-desc;
    in-out property <string> method-instructions;
    in-out property <bool> method-enabled: true;
    in property <string> method-status: "";
    in property <bool> method-adding: false;
    in property <[RecipeItem]> recipes;
    in-out property <string> recipe-name;
    in-out property <string> recipe-desc;
    in-out property <string> recipe-command;
    in-out property <string> recipe-params;
    in-out property <bool> recipe-enabled: true;
    in property <string> recipe-params-error: "";
    in property <string> recipe-status: "";
    in property <bool> recipe-adding: false;

    // --- Model browser -----------------------------------------------------
    in property <[ModelItem]> model-rows;
    in-out property <[ModelItem]> all-model-rows;
    in-out property <string> model-search;
    in property <bool> model-searching: false;
    in property <string> model-search-error: "";

    // --- Agents ------------------------------------------------------------
    in property <[AgentItem]> agents;
    in-out property <string> agent-name;
    in-out property <string> agent-prompt;
    in-out property <string> agent-model;
    in-out property <string> agent-working-dir;
    in-out property <string> agent-soul;
    in-out property <bool> agent-memory;
    in-out property <bool> agent-tools;
    in-out property <bool> agent-computer-use;
    in-out property <bool> agent-image-generation;
    in-out property <string> editing-agent: "";
    // Busy/status feedback for the Save action (P-busy "Agent Save gives no
    // feedback") — set by Rust around the DB upsert + SOUL write.
    in property <bool> agent-saving: false;
    in property <bool> agent-loading: false;
    in property <bool> agent-deleting: false;
    in property <string> agent-save-status: "";
    in property <bool> agent-save-is-error: false;
    in-out property <string> agent-run-input;
    in-out property <string> agent-run-state;
    in-out property <string> agent-run-result;

    // --- Transcribe (file / URL STT + summary + Artifacts) -----------------
    in-out property <string> transcribe-source: "";
    in-out property <string> transcribe-lang: "Auto";
    in-out property <string> transcribe-format: "text";
    in-out property <string> transcribe-status: "";
    in-out property <bool> transcribe-busy: false;
    in-out property <bool> transcribe-has-result: false;
    // The pre-rendered outputs (set once per run); `transcribe-output` selects
    // among them by format so toggling is instant and Rust-free.
    in-out property <string> transcribe-out-text: "";
    in-out property <string> transcribe-out-timestamps: "";
    in-out property <string> transcribe-out-srt: "";
    in-out property <string> transcribe-out-vtt: "";
    in-out property <string> transcribe-out-summary: "";
    // Serialized Transcript JSON for the current result (used by Save to Artifacts).
    in-out property <string> transcribe-data: "";
    in property <[TranscriptItem]> transcribe-artifacts: [];
    in-out property <string> transcribe-selected-artifact: "";
    out property <string> transcribe-output:
        root.transcribe-format == "timestamps" ? root.transcribe-out-timestamps
        : root.transcribe-format == "srt" ? root.transcribe-out-srt
        : root.transcribe-format == "vtt" ? root.transcribe-out-vtt
        : root.transcribe-format == "summary" ? root.transcribe-out-summary
        : root.transcribe-out-text;

    // --- Artifacts view (view 5) --------------------------------------------
    in property <[ArtifactItem]> artifacts-list: [];
    in-out property <string> artifacts-status: "";
    in-out property <bool> artifacts-viewer-open: false;
    in-out property <string> artifacts-viewer-title: "";
    in-out property <string> artifacts-viewer-text: "";
    // Image preview + actions (P2 "images"): see `artifacts.slint`'s own
    // property docs for what each carries.
    in-out property <bool> artifacts-viewer-is-image: false;
    in-out property <image> artifacts-viewer-image;
    in-out property <string> artifacts-viewer-artifact-id: "";
    in-out property <bool> artifacts-viewer-busy: false;
    in-out property <bool> artifacts-viewer-opening: false;
    in-out property <string> artifacts-renaming-id: "";
    in-out property <string> artifacts-rename-text: "";
    callback artifacts-refresh();
    callback artifacts-register-folder();
    callback artifacts-open(string);
    callback artifacts-delete(string);
    callback artifacts-rename(string, string);
    callback artifacts-edit-image(string, string);
    callback artifacts-variation-image(string);
    callback artifacts-upscale-image(string);

    // --- Chat composer: Artifacts picker (recent artifacts by title) -------
    in property <[ArtifactItem]> composer-artifacts: [];
    in-out property <bool> artifact-picker-open: false;
    callback open-artifact-picker();
    callback pick-artifact(string);
    callback clear-pending-artifact();

    // --- Activity view (view 6): live + historical agent runs --------------
    // P4 "Consolidate navigation": also the hub for Artifacts/Transcribe/
    // Memory (see the artifacts-*/transcribe-*/memory-* properties below,
    // now bound into ActivityView instead of standalone rail views).
    // 0=Runs, 1=Artifacts, 2=Transcribe, 3=Memory.
    in-out property <int> activity-sub-view: 0;
    in property <[ActivityItem]> activity-tasks: [];
    in-out property <string> activity-selected-task: "";
    in-out property <string> activity-clarify-reply: "";
    // True while any task is Pending/Running/NeedsClarification — badges the
    // rail icon so the user notices without having to open the view.
    in property <bool> activity-has-live: false;
    // Resolved by Rust from `activity-tasks` + `activity-selected-task` on
    // every refresh/select (see `bridge::apply_activity_tasks`).
    in property <ActivityItem> activity-detail;
    in property <bool> activity-has-selection: false;
    callback activity-refresh();
    callback activity-select-task(string);
    callback activity-cancel-task(string);
    callback activity-answer-clarification(string, string);

    // --- Welcome / first-run setup -----------------------------------------
    in-out property <bool> show-welcome: false;
    in property <string> welcome-hw: "Detecting hardware…";
    in-out property <string> welcome-models-dir: "";
    in property <string> welcome-disk-free: "";
    in property <string> welcome-model-id: "";
    in property <string> welcome-model-label: "";
    in property <string> welcome-model-detail: "";
    // A smaller, known-good alternative (`ModelRecommendation::fallback`) —
    // empty when the primary pick has none (e.g. it's already the smallest
    // tier). Surfaced as a real, visible choice rather than only reachable
    // later via Settings → Models, since the Flagship tier's ~21 GB primary
    // pick is a much bigger first-run commitment than anything offered
    // before it existed.
    in property <string> welcome-model-fallback-id: "";
    in property <string> welcome-model-fallback-label: "";
    in property <string> welcome-model-fallback-detail: "";
    // Backing value for the low-disk check, re-derived whenever the storage
    // location changes (the free-space comparison needs the currently
    // selected model's size, not just its already-formatted detail text).
    in-out property <float> welcome-model-approx-gb: 0.0;
    // True when the *currently selected* model (primary or, after switching,
    // the fallback) is bigger than the free space on `welcome-models-dir`.
    in property <bool> welcome-model-low-disk: false;
    in-out property <string> welcome-model-status: "";
    // Live byte-level progress for the wizard's recommended-model download,
    // populated by the same `dl_progress` registry the Models view polls
    // (see `on_welcome_download_model` in lib.rs).
    in-out property <bool> welcome-model-downloading: false;
    in property <bool> welcome-model-installed: false;
    in-out property <float> welcome-model-progress: 0.0;
    in-out property <string> welcome-ffmpeg-status: "";
    in-out property <string> welcome-wsl-status: "";
    in-out property <string> welcome-voice-status: "";
    // P4 "First-run polish": telemetry consent as its own distinct first-run
    // decision (a real Enable/Disable choice on this screen) rather than only
    // a buried Settings checkbox nobody sees before `needs_consent_decision`
    // silently resolves to "off" via `setup_completed`. Defaults `false` —
    // stays off unless the user actively picks "Enable" (security model:
    // opt-in, off by default; this control can only ever turn it on, never
    // silently on by default).
    in-out property <bool> welcome-telemetry-enabled: false;
    callback welcome-pick-dir();
    callback welcome-download-model();
    // Swap the active recommendation to `welcome-model-fallback-*` (Rust
    // recomputes the whole chain and re-seeds the *-id/label/detail
    // properties from the fallback — see `on_welcome_use_fallback_model`).
    callback welcome-use-fallback-model();
    callback welcome-install-ffmpeg();
    callback welcome-install-wsl();
    callback welcome-prepare-voice();
    callback welcome-finish();
    // Explicit Skip (P4 "First-run polish" — "Get started" doubled as both
    // finish and skip; this is now a visually distinct, de-emphasized
    // control). Still records whatever telemetry choice is currently
    // selected (default off) — skipping never bypasses that decision, it
    // just doesn't insist you also picked a model / installed extras first.
    callback welcome-skip();

    // --- Callbacks out -----------------------------------------------------
    callback send(string);
    callback stop();
    // Open a file picker and attach the chosen document to the next message.
    callback attach-file();
    callback clear-attachment();
    // Toggle mic capture; on stop, transcribe into the composer.
    callback voice-input();
    // Copy an assistant message's text to the clipboard.
    callback copy-message(string);
    // Open a link clicked inside rendered markdown prose (P0 inline
    // markdown) in the user's default browser.
    callback open-link(string);
    // Speak an assistant message aloud via the local voice synthesizer
    // (message id, message text). Mirrors copy-message, plus the id so the
    // busy/playing state can be shown on just that message's button.
    callback speak-message(string, string);
    // Save a code block to disk via the native dialog (code text, language hint
    // for the default extension). Downloadable-artifact affordance.
    callback save-code(string, string);
    // Record interaction feedback on a message (message id, kind: "thumbs_up" |
    // "thumbs_down"). Captured as interaction-learning ground truth.
    callback message-feedback(string, string);
    // Regenerate the assistant reply identified by its message id.
    callback regenerate(string);
    // Put a user message back into the composer for editing (text, message id).
    callback edit-message(string, string);
    // Branch navigator (P0): switch to a sibling fork at this message's fork
    // point (message id, step direction: -1 = previous / +1 = next). Reloads
    // that sibling's own downstream transcript.
    callback switch-branch(string, int);
    // Open an inline-rendered generated image's backing artifact in the
    // Artifacts view (P2 "inline images"): artifact id.
    callback open-generated-image(string);
    callback select-session(int);
    callback new-session();
    callback delete-session(int);
    callback rename-session(int, string);
    // Export this session's transcript to a file the user picks (P2 "Export
    // chat button"): row index.
    callback export-session(int);
    // Row index being renamed inline (-1 = none) / pending delete-confirm (-1 = none).
    in-out property <int> renaming-session: -1;
    in-out property <int> confirming-delete-session: -1;
    in-out property <string> rename-text;
    callback select-model(string);
    callback setting-changed();
    callback search-models(string);
    callback download-model(string);
    callback cancel-download-model(string);
    callback delete-model(string);
    callback set-default-model(string);
    callback refresh-models();
    callback save-agent();
    callback delete-agent(string);
    callback new-agent();
    callback select-agent(string);
    callback run-agent-foreground();
    callback run-agent-background();
    // Transcribe view.
    callback transcribe-pick-file();
    callback transcribe-start();
    callback transcribe-save();
    callback transcribe-copy();
    callback transcribe-summarize();
    callback transcribe-save-artifact();
    callback transcribe-load-artifact(string);
    callback transcribe-delete-artifact(string);
    callback add-mcp();
    callback remove-mcp(string);
    callback add-schedule();
    callback remove-schedule(string);
    callback toggle-schedule(string);
    callback add-watcher();
    callback remove-watcher(string);
    callback toggle-watcher(string);
    callback search-memory();
    callback add-skill();
    callback remove-skill(string);
    callback toggle-skill(string);
    callback add-method();
    callback remove-method(string);
    callback toggle-method(string);
    callback add-recipe();
    callback remove-recipe(string);
    callback toggle-recipe(string);
    callback test-redaction();
    callback provision-sandbox();

    // --- Frameless window chrome (opt-in; custom title bar) -----------------
    in-out property <bool> frameless: false;
    callback window-minimize();
    callback window-maximize();
    callback window-close();
    // Emitted on title-bar press so the Rust side can start an OS window drag.
    callback window-drag();

    // --- Update notification (set by the telemetry update check) ------------
    in-out property <string> update-version: ""; // empty = up to date
    in-out property <string> update-notes: "";
    callback open-update();   // open the download URL
    callback dismiss-update();

    // Called from Rust after starting a new session. The composer lives inside
    // the (conditional) chat view, so this is a best-effort no-op kept for the
    // Rust call site; switching to the chat view already reveals the composer.
    public function focus-composer() {
    }

    // Keyboard map (native feel): Ctrl+N new chat, Ctrl+, settings, Esc closes
    // the model overlay (or, while streaming, mirrors the Stop button so the
    // user can abort generation without reaching for the mouse). Keys a
    // focused input doesn't consume bubble up to here.
    kb := FocusScope {
        width: 100%;
        height: 100%;
        key-pressed(event) => {
            if (event.modifiers.control && event.text == "n") {
                root.active-view = 0;
                root.new-session();
                return accept;
            }
            if (event.modifiers.control && event.text == ",") {
                root.active-view = 2;
                return accept;
            }
            if (event.text == Key.Escape && root.model-open) {
                root.model-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.artifact-picker-open) {
                root.artifact-picker-open = false;
                return accept;
            }
            if (event.text == Key.Escape && root.streaming) {
                root.stop();
                return accept;
            }
            return reject;
        }
    VerticalLayout {
        spacing: 0;
        // Smith's own title bar (only in frameless mode; OS frame is hidden then).
        if root.frameless : TitleBar {
            minimize => { root.window-minimize(); }
            maximize => { root.window-maximize(); }
            close => { root.window-close(); }
            drag => { root.window-drag(); }
        }
    // ===== transient status banner (downloads, provisioning, errors) =====
    if root.status-text != "": Rectangle {
        height: 36px;
        width: 100%;
        background: Palette.accent;
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 6px;
            spacing: 8px;
            Text {
                text: root.status-text;
                color: Palette.white;
                font-family: Palette.font-mono;
                font-size: 12px;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
                min-width: 0px;
            }
            Rectangle { horizontal-stretch: 1; }
            Rectangle {
                width: 26px;
                Icon { source: Icons.x; size: 14px; stroke: Palette.white; }
                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.status-text = "";
                    }
                }
            }
        }
    }

        // Update banner: shown when the telemetry check finds a newer release.
        if root.update-version != "" : Rectangle {
            height: 40px;
            background: Palette.accent;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 8px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "⬆ Smith " + root.update-version + " is available"
                            + (root.update-notes != "" ? " — " + root.update-notes : "");
                        color: Palette.white;
                        font-size: 13px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    SmithButton {
                        text: "Download";
                        kind: "secondary";
                        clicked => { root.open-update(); }
                    }
                }
                Rectangle {
                    width: 28px;
                    Icon { source: Icons.x; size: 14px; stroke: Palette.white; }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.dismiss-update(); }
                    }
                }
            }
        }
        if root.download-items.length > 0 && !root.show-welcome: Rectangle {
            background: Palette.sunken;
            height: download-summary.preferred-height;
            download-summary := VerticalLayout {
                padding: 12px;
                spacing: 6px;
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        Text {
                            text: (root.download-items[0].downloading ? "Downloading " : "Download stopped: ") + root.download-items[0].name;
                            color: Palette.text-strong;
                            font-size: 13px;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text {
                            text: root.download-items[0].dl-status;
                            color: root.download-items[0].dl-error ? Palette.red : Palette.text-body;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                    SmithButton {
                        text: "Downloads (" + root.download-items.length + ")";
                        kind: "secondary";
                        width: 140px;
                        clicked => { root.active-view = 1; root.model-search = ""; root.search-models(""); }
                    }
                    SmithButton {
                        text: root.download-items[0].downloading ? "Cancel" : "Retry";
                        kind: "secondary";
                        width: 90px;
                        clicked => {
                            if root.download-items[0].downloading { root.cancel-download-model(root.download-items[0].id); }
                            else { root.download-model(root.download-items[0].id); }
                        }
                    }
                    if root.download-items[0].dl-error: SmithButton {
                        text: "Dismiss"; kind: "ghost"; width: 90px;
                        clicked => { root.dismiss-download(root.download-items[0].id); }
                    }
                }
                if root.download-items[0].downloading: Rectangle {
                    height: 5px; background: Palette.border; border-radius: 3px;
                    Rectangle {
                        x: 0;
                        y: 0;
                        width: parent.width * root.download-items[0].progress;
                        height: parent.height; background: Palette.accent; border-radius: 3px;
                        animate width { duration: 200ms; }
                    }
                }
                if root.download-items[0].downloading: Text {
                    text: "Keep Smith open. Chat will be ready after the download and file verification finish.";
                    color: Palette.text-muted; font-size: 11px; wrap: word-wrap;
                }
            }
        }
    HorizontalLayout {
        width: 100%;
        vertical-stretch: 1;
        spacing: 0;

        // ============================== icon rail ==============================
        Rectangle {
            width: 64px;
            background: Palette.rail;
            VerticalLayout {
                padding-top: 18px;
                padding-bottom: 16px;
                spacing: 8px;
                // Default `stretch` alignment so the spacer below pushes the
                // settings icon to the bottom of the rail.

                // Brand mark.
                HorizontalLayout {
                    alignment: center;
                    padding-bottom: 10px;
                    Image {
                        source: @image-url("../assets/icon-256.png");
                        width: 34px;
                        height: 34px;
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    RailButton {
                        icon: @image-url("../assets/icons/chat.svg");
                        label: "Chat";
                        active: root.active-view == 0;
                        clicked => {
                            root.active-view = 0;
                        }
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    RailButton {
                        icon: @image-url("../assets/icons/cpu.svg");
                        label: "Models";
                        active: root.active-view == 1;
                        clicked => {
                            root.active-view = 1;
                        }
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    RailButton {
                        icon: @image-url("../assets/icons/users.svg");
                        label: "Agents & Autonomy";
                        active: root.active-view == 3;
                        clicked => {
                            root.active-view = 3;
                        }
                    }
                }
                HorizontalLayout {
                    alignment: center;
                    RailButton {
                        // P4 "Consolidate navigation": the rail is now ≤5
                        // destinations with Chat first. Artifacts and
                        // Transcribe are no longer separate rail buttons —
                        // they're sub-tabs of this Activity hub (alongside
                        // Runs and Memory), since all four are "things that
                        // accumulate from using the app" rather than
                        // day-to-day chat surfaces.
                        icon: @image-url("../assets/icons/activity.svg");
                        label: "Activity";
                        active: root.active-view == 6;
                        show-badge: root.activity-has-live;
                        clicked => {
                            root.active-view = 6;
                            root.activity-refresh();
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }

                HorizontalLayout {
                    alignment: center;
                    RailButton {
                        icon: @image-url("../assets/icons/sliders.svg");
                        label: "Settings";
                        active: root.active-view == 2;
                        clicked => {
                            root.active-view = 2;
                        }
                    }
                }
            }
        }

        // ===================== session list (chat view only) ==================
        if root.active-view == 0: Rectangle {
            width: root.compact-layout ? 220px : 300px;
            background: Palette.page;
            // Right hairline.
            Rectangle {
                x: parent.width - 1px;
                width: 1px;
                background: Palette.border;
            }
            VerticalLayout {
                padding: 18px;
                spacing: 14px;

                Text {
                    text: "Chats";
                    color: Palette.text-strong;
                    font-family: Palette.font-display;
                    font-size: 22px;
                    font-weight: 600;
                }

                SmithButton {
                    text: "+   New chat";
                    kind: "primary";
                    clicked => {
                        root.new-session();
                    }
                }

                // Session search (P4 "Session search in the chat sidebar") —
                // filters by title/subtitle as you type; rename/delete/export
                // already existed on each row, search didn't.
                HorizontalLayout {
                    spacing: 6px;
                    session-search := LineEdit {
                        horizontal-stretch: 1;
                        placeholder-text: "Search chats…";
                        text <=> root.session-query;
                        edited(q) => { root.filter-sessions(q); }
                    }
                    if root.session-query != "": Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: Palette.radius;
                        background: clear-search-ta.has-hover ? Palette.hover : transparent;
                        Icon { source: Icons.x; size: 13px; stroke: Palette.text-subtle; }
                        clear-search-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.session-query = "";
                                root.filter-sessions("");
                            }
                        }
                    }
                }

                if root.sessions.length == 0 && root.session-query != "": EmptyState {
                    icon: Icons.search;
                    title: "No matching chats";
                    message: "Nothing matches \"" + root.session-query + "\". Try a different search.";
                }

                if root.sessions.length > 0 || root.session-query == "": ListView {
                    vertical-stretch: 1;
                    for s[idx] in root.sessions: Rectangle {
                        height: idx == root.selected-session || row-touch.has-hover
                            || root.confirming-delete-session == idx ? 82px : 62px;
                        border-radius: Palette.radius;
                        background: idx == root.selected-session
                            ? Palette.sunken
                            : (row-touch.has-hover ? Palette.hover : transparent);
                        animate background { duration: 100ms; }

                        // Red active bar.
                        Rectangle {
                            x: 0;
                            y: 12px;
                            width: 3px;
                            height: parent.height - 24px;
                            border-radius: 2px;
                            background: Palette.accent;
                            opacity: idx == root.selected-session ? 1.0 : 0.0;
                        }

                        // Select on click — disabled while this row is being
                        // renamed or is awaiting delete-confirm.
                        row-touch := TouchArea {
                            mouse-cursor: pointer;
                            enabled: root.renaming-session != idx
                                && root.confirming-delete-session != idx;
                            clicked => {
                                root.selected-session = idx;
                                root.select-session(idx);
                            }
                        }
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 12px;
                            spacing: 12px;
                            if root.renaming-session != idx
                                && root.confirming-delete-session != idx: VerticalLayout {
                                alignment: center;
                                Avatar {
                                    initials: "S";
                                    red-tone: idx == root.selected-session;
                                    diameter: 36px;
                                }
                            }
                            // Inline rename editor — an explicit Save
                            // (check) / Discard (x) icon pair, not just
                            // Enter-to-commit-with-no-way-back, mirroring the
                            // Delete/Cancel pair directly below.
                            if root.renaming-session == idx: VerticalLayout {
                                alignment: center;
                                spacing: 4px;
                                rename-input := LineEdit {
                                    min-width: 0px;
                                    text: root.rename-text;
                                    edited(t) => { root.rename-text = t; }
                                    accepted(t) => {
                                        root.rename-session(idx, t);
                                        root.renaming-session = -1;
                                    }
                                }
                                HorizontalLayout {
                                    alignment: start;
                                    spacing: 4px;
                                    Rectangle {
                                        width: 22px;
                                        height: 22px;
                                        border-radius: 4px;
                                        background: save-session-rename-ta.has-hover ? Palette.hover : transparent;
                                        Icon { source: Icons.check; size: 13px; stroke: Palette.accent; }
                                        save-session-rename-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.rename-session(idx, root.rename-text);
                                                root.renaming-session = -1;
                                            }
                                        }
                                    }
                                    Rectangle {
                                        width: 22px;
                                        height: 22px;
                                        border-radius: 4px;
                                        background: discard-session-rename-ta.has-hover ? Palette.hover : transparent;
                                        Icon { source: Icons.x; size: 13px; stroke: Palette.text-subtle; }
                                        discard-session-rename-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.renaming-session = -1; }
                                        }
                                    }
                                }
                            }
                            // Delete confirmation.
                            if root.confirming-delete-session == idx: VerticalLayout {
                                alignment: center;
                                spacing: 8px;
                                Text {
                                    vertical-alignment: center;
                                    text: "Delete chat?";
                                    color: Palette.text-strong;
                                    font-family: Palette.font-body;
                                    font-size: 13px;
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    SmithButton {
                                        text: "Delete";
                                        kind: "destructive";
                                        clicked => {
                                            root.confirming-delete-session = -1;
                                            root.delete-session(idx);
                                        }
                                    }
                                    SmithButton {
                                        text: "Cancel";
                                        kind: "ghost";
                                        clicked => { root.confirming-delete-session = -1; }
                                    }
                                }
                            }
                            // Normal: title + subtitle, with hover actions.
                            if root.renaming-session != idx
                                && root.confirming-delete-session != idx: VerticalLayout {
                                alignment: center;
                                spacing: 3px;
                                Text {
                                    text: s.title;
                                    color: Palette.text-strong;
                                    font-family: Palette.font-body;
                                    font-size: 14px;
                                    font-weight: 600;
                                    overflow: elide;
                                }
                                Text {
                                    text: s.subtitle;
                                    color: Palette.text-muted;
                                    font-family: Palette.font-body;
                                    font-size: 12px;
                                    overflow: elide;
                                }
                                // Keep actions below the title so compact sidebars
                                // retain enough room to identify the conversation.
                                if row-touch.has-hover || idx == root.selected-session: HorizontalLayout {
                                    alignment: start;
                                    spacing: 6px;
                                    Rectangle {
                                        width: 18px;
                                        height: 18px;
                                        Image {
                                            width: 13px;
                                            height: 13px;
                                            source: Icons.edit;
                                            colorize: session-rename-ta.has-hover ? Palette.accent : Palette.text-subtle;
                                        }
                                        session-rename-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.rename-text = s.title;
                                                root.confirming-delete-session = -1;
                                                root.renaming-session = idx;
                                            }
                                        }
                                    }
                                    Rectangle {
                                        width: 18px;
                                        height: 18px;
                                        Image {
                                            width: 13px;
                                            height: 13px;
                                            source: Icons.trash;
                                            colorize: trash-ta.has-hover ? Palette.accent : Palette.text-subtle;
                                        }
                                        trash-ta := TouchArea {
                                            enabled: !root.streaming && root.chat-operation == "";
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.renaming-session = -1;
                                                root.confirming-delete-session = idx;
                                            }
                                        }
                                    }
                                    // Export this conversation (P2 "Export chat
                                    // button") — md/json, via a native Save dialog.
                                    Rectangle {
                                        width: 18px;
                                        height: 18px;
                                        Image {
                                            width: 13px;
                                            height: 13px;
                                            source: Icons.download;
                                            colorize: export-ta.has-hover ? Palette.accent : Palette.text-subtle;
                                        }
                                        export-ta := TouchArea {
                                            enabled: !root.export-session-saving;
                                            mouse-cursor: root.export-session-saving ? default : pointer;
                                            clicked => {
                                                root.export-session(idx);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ============================= thread (chat view) =====================
        if root.active-view == 0: Rectangle {
            horizontal-stretch: 1;
            background: Palette.sunken;
            VerticalLayout {
                spacing: 0;

                // ---- thread header ----
                Rectangle {
                    height: 64px;
                    background: Palette.page;
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Palette.border;
                    }
                    HorizontalLayout {
                        padding-left: 24px;
                        padding-right: 20px;
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: (root.selected-session >= 0
                                    && root.selected-session < root.sessions.length)
                                    ? root.sessions[root.selected-session].title
                                    : "New chat";
                                color: Palette.text-strong;
                                font-family: Palette.font-display;
                                font-size: 16px;
                                overflow: elide;
                                font-weight: 600;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout {
                            alignment: center;
                            StatusPill {
                                show-dot: true;
                                // Honest status dot: green only once the
                                // server has actually answered `/health`;
                                // amber while unknown/degraded, red once a
                                // probe has failed outright.
                                dot-color: root.server-status == "online"
                                    ? Palette.online
                                    : (root.server-status == "offline" ? Palette.red : Palette.warning);
                                text: root.server-address;
                            }
                        }
                        // Interactive model selector — opens downward so it never
                        // gets clamped (unlike a bottom-anchored composer popup).
                        VerticalLayout {
                            alignment: center;
                            hdr-model := Rectangle {
                                changed absolute-position => {
                                    root.model-anchor-x = self.absolute-position.x;
                                    root.model-anchor-y = self.absolute-position.y + self.height;
                                }
                                accessible-role: button;
                                accessible-label: "Active model: " + root.active-model + ". Open model picker";
                                accessible-action-default => {
                                    root.model-anchor-x = self.absolute-position.x;
                                    root.model-anchor-y = self.absolute-position.y + self.height;
                                    root.artifact-picker-open = false;
                                    root.model-open = !root.model-open;
                                }
                                height: 28px;
                                width: min(hdr-row.preferred-width + 22px, root.compact-layout ? 180px : 300px);
                                border-radius: Palette.radius;
                                border-width: 1px;
                                border-color: Palette.border;
                                background: hdr-touch.has-hover ? Palette.sunken : Palette.raised;
                                hdr-row := HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 8px;
                                    spacing: 6px;
                                    Text {
                                        text: root.active-model;
                                        overflow: elide;
                                        min-width: 0px;
                                        horizontal-stretch: 1;
                                        color: Palette.text-body;
                                        font-family: Palette.font-mono;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        Image {
                                            source: @image-url("../assets/icons/chevron-down.svg");
                                            width: 12px;
                                            height: 12px;
                                            colorize: Palette.text-subtle;
                                        }
                                    }
                                }
                                hdr-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.model-anchor-x = hdr-model.absolute-position.x;
                                        root.model-anchor-y = hdr-model.absolute-position.y + hdr-model.height;
                                        root.artifact-picker-open = false;
                                        root.model-open = !root.model-open;
                                    }
                                }
                            }
                        }
                    }
                }

                // ---- messages ----
                Rectangle {
                    vertical-stretch: 1;
                    background: Palette.sunken;

                    // `chat-scroll` is always instantiated (never behind an
                    // `if`) so its id stays addressable from the "jump to
                    // latest" chip below (a sibling in this same Rectangle).
                    // It's simply empty (0 rows) while there are no messages;
                    // the empty-state block further below paints over it.
                    chat-scroll := ScrollView {
                        // Re-pin to the bottom on every rendered-height change
                        // while pinned (covers new messages AND in-place growth
                        // from streamed tokens — both change `viewport-height`).
                        changed viewport-height => {
                            if (root.pinned-to-bottom) {
                                chat-scroll.viewport-y = min(0px, chat-scroll.visible-height - chat-scroll.viewport-height);
                            }
                        }
                        // A real user scroll gesture (drag/wheel — never fires
                        // for our own programmatic `viewport-y` writes above).
                        // Re-pin only if they scrolled back near the bottom;
                        // otherwise show the "jump to latest" chip.
                        scrolled => {
                            // Distance from the true bottom: 0 when fully
                            // scrolled down, growing as the user scrolls up.
                            root.pinned-to-bottom =
                                chat-scroll.viewport-height - chat-scroll.visible-height + chat-scroll.viewport-y < 32px;
                        }
                        VerticalLayout {
                            padding: 28px;
                            spacing: 16px;
                            // `start` so rows stack at the top at their natural
                            // height (Slint layouts default to `stretch`, which is
                            // what made bubbles balloon vertically).
                            alignment: start;
                            for m in root.messages: HorizontalLayout {
                                spacing: 13px;
                                // User turn hugs the right; the assistant turn leads
                                // with the red brand mark and fills the column (DS).
                                if m.role == "user": Rectangle { horizontal-stretch: 1; }
                                if m.role != "user": VerticalLayout {
                                    alignment: start;
                                    AssistantMark { }
                                }
                                VerticalLayout {
                                    alignment: start;
                                    spacing: 8px;
                                    horizontal-stretch: m.role == "user" ? 0 : 1;
                                    max-width: m.role == "user" ? root.width * 0.78 : root.width;

                                    // Assistant name — mono uppercase (DS ChatMessage).
                                    if m.role != "user": Text {
                                        text: "SMITH";
                                        color: Palette.text-subtle;
                                        font-family: Palette.font-mono;
                                        font-size: 11px;
                                        letter-spacing: 0.5px;
                                    }

                                    // DS ThinkingBlock — collapsible model reasoning.
                                    if m.role != "user" && m.reasoning != "": tb := Rectangle {
                                        property <bool> expanded: false;
                                        max-width: root.width * 0.6;
                                        height: tb-body.preferred-height;
                                        border-radius: Palette.radius;
                                        border-width: 1px;
                                        border-color: Palette.border;
                                        background: Palette.sunken;
                                        TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { tb.expanded = !tb.expanded; }
                                        }
                                        tb-body := VerticalLayout {
                                            padding: 9px;
                                            spacing: 6px;
                                            Text {
                                                text: tb.expanded ? "Thinking — hide reasoning" : "Thinking — show reasoning";
                                                color: tb.expanded ? Palette.text-body : Palette.text-muted;
                                                font-family: Palette.font-mono;
                                                font-size: 11px;
                                            }
                                            if tb.expanded: Text {
                                                text: m.reasoning;
                                                color: Palette.text-subtle;
                                                font-family: Palette.font-mono;
                                                font-size: 11px;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }

                                    Rectangle {
                                        max-width: m.role == "user" ? root.width * 0.78 : root.width;
                                        // Hug the text height — never stretch.
                                        height: bubble-body.preferred-height;
                                        border-radius: Palette.radius;
                                        border-width: 0px;
                                        // DS: user = solid black bubble; assistant = no
                                        // bubble (bare, full-width).
                                        background: m.role == "user"
                                            ? Palette.user-bubble
                                            : transparent;
                                        bubble-body := VerticalLayout {
                                            padding-left: m.role == "user" ? 15px : 0px;
                                            padding-right: m.role == "user" ? 15px : 0px;
                                            padding-top: m.role == "user" ? 11px : 0px;
                                            padding-bottom: m.role == "user" ? 11px : 0px;
                                            spacing: 8px;
                                            // DS MarkdownContent + CodeBlock: prose
                                            // renders as text; ``` fences render in a
                                            // monospace code box.
                                            for seg in m.segments: VerticalLayout {
                                                if seg.kind == "code": Rectangle {
                                                    border-radius: 4px;
                                                    border-width: 1px;
                                                    border-color: Palette.border;
                                                    background: Palette.sunken;
                                                    height: ct.preferred-height + 20px;
                                                    ct := Text {
                                                        x: 11px;
                                                        y: 10px;
                                                        width: parent.width - 40px;
                                                        text: seg.text;
                                                        color: Palette.text-body;
                                                        font-family: Palette.font-mono;
                                                        font-size: 12.5px;
                                                        wrap: word-wrap;
                                                    }
                                                    // DS CodeBlock save affordance: download the block to
                                                    // disk via the native dialog (a downloadable artifact).
                                                    code-save := Rectangle {
                                                        x: parent.width - 50px;
                                                        y: 6px;
                                                        width: 20px;
                                                        height: 18px;
                                                        border-radius: 4px;
                                                        background: cs-ta.has-hover ? Palette.hover : Palette.muted;
                                                        Text {
                                                            text: "⤓";
                                                            color: cs-ta.has-hover ? Palette.accent : Palette.text-subtle;
                                                            font-size: 13px;
                                                        }
                                                        cs-ta := TouchArea {
                                                            enabled: !root.code-block-saving;
                                                            mouse-cursor: root.code-block-saving ? default : pointer;
                                                            clicked => {
                                                                root.save-code(seg.text, seg.lang);
                                                            }
                                                        }
                                                    }
                                                    // DS CodeBlock copy affordance: a per-block copy
                                                    // button (flips to a ✓ tick for a moment).
                                                    code-copy := Rectangle {
                                                        x: parent.width - 26px;
                                                        y: 6px;
                                                        width: 20px;
                                                        height: 18px;
                                                        border-radius: 4px;
                                                        background: cc-ta.has-hover ? Palette.hover : Palette.muted;
                                                        property <bool> copied: false;
                                                        if !code-copy.copied: Image {
                                                            width: 12px;
                                                            height: 12px;
                                                            source: @image-url("../assets/icons/copy.svg");
                                                            colorize: cc-ta.has-hover ? Palette.accent : Palette.text-subtle;
                                                        }
                                                        if code-copy.copied: Text {
                                                            text: "✓";
                                                            color: Palette.accent;
                                                            font-size: 12px;
                                                        }
                                                        cc-timer := Timer {
                                                            interval: 1200ms;
                                                            running: false;
                                                            triggered => {
                                                                code-copy.copied = false;
                                                                cc-timer.running = false;
                                                            }
                                                        }
                                                        cc-ta := TouchArea {
                                                            mouse-cursor: pointer;
                                                            clicked => {
                                                                root.copy-message(seg.text);
                                                                code-copy.copied = true;
                                                                cc-timer.running = true;
                                                            }
                                                        }
                                                    }
                                                }
                                                if seg.kind == "tool": Rectangle {
                                                    // DS tool-call card: the tool an agent ran + its args.
                                                    border-radius: 4px;
                                                    border-width: 1px;
                                                    border-color: Palette.accent;
                                                    background: Palette.sunken;
                                                    height: tlay.preferred-height + 16px;
                                                    tlay := VerticalLayout {
                                                        height: self.preferred-height;
                                                        x: 11px;
                                                        y: 8px;
                                                        width: parent.width - 22px;
                                                        spacing: 4px;
                                                        Text {
                                                            text: "🔧 " + seg.lang;
                                                            color: Palette.accent;
                                                            font-family: Palette.font-mono;
                                                            font-size: 12px;
                                                            font-weight: 600;
                                                        }
                                                        Text {
                                                            text: seg.text;
                                                            color: Palette.text-muted;
                                                            font-family: Palette.font-mono;
                                                            font-size: 11.5px;
                                                            wrap: word-wrap;
                                                        }
                                                    }
                                                }
                                                // DS live checklist card: an `update_plan` /
                                                // `todo` loop-tool call, rendered as a real
                                                // checkbox list instead of raw JSON args.
                                                if seg.kind == "plan": Rectangle {
                                                    border-radius: 4px;
                                                    border-width: 1px;
                                                    border-color: Palette.border;
                                                    background: Palette.sunken;
                                                    height: plan-lay.preferred-height + 16px;
                                                    plan-lay := VerticalLayout {
                                                        height: self.preferred-height;
                                                        x: 11px;
                                                        y: 8px;
                                                        width: parent.width - 22px;
                                                        spacing: 4px;
                                                        Text {
                                                            text: "☑ Plan";
                                                            color: Palette.text-subtle;
                                                            font-family: Palette.font-mono;
                                                            font-size: 12px;
                                                            font-weight: 600;
                                                        }
                                                        Text {
                                                            text: seg.text;
                                                            color: Palette.text-body;
                                                            font-family: Palette.font-mono;
                                                            font-size: 12.5px;
                                                            wrap: word-wrap;
                                                        }
                                                    }
                                                }
                                                // DS question prompt: an `ask_clarification` /
                                                // `clarify` loop-tool call, rendered as an actual
                                                // question with an inline reply box instead of raw
                                                // JSON args — typing an answer and sending it just
                                                // continues the conversation normally.
                                                if seg.kind == "clarify": clarify-card := Rectangle {
                                                    property <string> reply-text: "";
                                                    border-radius: 4px;
                                                    border-width: 1px;
                                                    border-color: Palette.accent;
                                                    background: Palette.sunken;
                                                    height: clarify-lay.preferred-height + 16px;
                                                    clarify-lay := VerticalLayout {
                                                        height: self.preferred-height;
                                                        x: 11px;
                                                        y: 8px;
                                                        width: parent.width - 22px;
                                                        spacing: 6px;
                                                        Text {
                                                            text: "❓ Question";
                                                            color: Palette.accent;
                                                            font-family: Palette.font-mono;
                                                            font-size: 12px;
                                                            font-weight: 600;
                                                        }
                                                        Text {
                                                            text: seg.text;
                                                            color: Palette.text-body;
                                                            font-family: Palette.font-body;
                                                            font-size: 13.5px;
                                                            wrap: word-wrap;
                                                        }
                                                        HorizontalLayout {
                                                            spacing: 6px;
                                                            clarify-reply := LineEdit {
                                                                placeholder-text: "Type your answer…";
                                                                text <=> clarify-card.reply-text;
                                                                accepted(text) => {
                                                                    if text != "" {
                                                                        root.send(text);
                                                                        clarify-card.reply-text = "";
                                                                    }
                                                                }
                                                            }
                                                            SmithButton {
                                                                text: "Reply";
                                                                kind: "secondary";
                                                                width: 70px;
                                                                clicked => {
                                                                    if clarify-reply.text != "" {
                                                                        root.send(clarify-reply.text);
                                                                        clarify-card.reply-text = "";
                                                                    }
                                                                }
                                                            }
                                                        }
                                                    }
                                                }
                // No-model empty state → one-click fix (P4): instead of just pointing at
                                                // Settings, an inline "Download recommended model" button —
                                                // reuses the welcome wizard's own download-with-progress flow
                                                // (`welcome-download-model`/`welcome-model-*`), not a new one.
                                                if seg.kind == "no-model": Rectangle {
                                                    border-radius: 4px;
                                                    border-width: 1px;
                                                    border-color: Palette.border;
                                                    background: Palette.sunken;
                                                    height: no-model-lay.preferred-height + 16px;
                                                    no-model-lay := VerticalLayout {
                                                        height: self.preferred-height;
                                                        x: 11px;
                                                        y: 8px;
                                                        width: parent.width - 22px;
                                                        spacing: 8px;
                                                        Text {
                                                            text: seg.text;
                                                            color: Palette.text-body;
                                                            font-family: Palette.font-body;
                                                            font-size: 13.5px;
                                                            wrap: word-wrap;
                                                        }
                                                        if root.welcome-model-downloading: VerticalLayout {
                                    SmithButton {
                                        text: "Cancel download";
                                        kind: "secondary";
                                        clicked => { root.cancel-download-model(root.welcome-model-id); }
                                    }
                                                            spacing: 4px;
                                                            Text {
                                                                text: root.welcome-model-status;
                                                                color: Palette.text-muted;
                                                                font-family: Palette.font-mono;
                                                                font-size: 11px;
                                                            }
                                                            Rectangle {
                                                                height: 6px;
                                                                border-radius: 3px;
                                                                background: Palette.border;
                                                                Rectangle {
                                                                    x: 0;
                                                                    height: parent.height;
                                                                    width: parent.width * clamp(root.welcome-model-progress, 0.0, 1.0);
                                                                    border-radius: 3px;
                                                                    background: Palette.accent;
                                                                    animate width { duration: 200ms; }
                                                                }
                                                            }
                                                        }
                                                        if !root.welcome-model-downloading: HorizontalLayout {
                                                            spacing: 8px;
                                                            SmithButton {
                                                                text: root.welcome-model-label == "" ? "Download recommended model" : "Download " + root.welcome-model-label;
                                                                kind: "primary";
                                                                clicked => { root.welcome-download-model(); }
                                                            }
                                                            if root.welcome-model-status != "": Text {
                                                                vertical-alignment: center;
                                                                text: root.welcome-model-status;
                                                                color: Palette.success;
                                                                font-family: Palette.font-mono;
                                                                font-size: 11px;
                                                                wrap: word-wrap;
                                                            }
                                                        }
                                                    }
                                                }
                                                // DS generated-image bubble (P2 "inline images"): a
                                                // `/imagine` reply renders the actual picture, not
                                                // just a text reference to the artifact. Clicking it
                                                // opens the backing artifact in the Artifacts view.
                                                if seg.kind == "image": Rectangle {
                                                    width: 320px;
                                                    height: 320px;
                                                    border-radius: Palette.radius;
                                                    border-width: 1px;
                                                    border-color: Palette.border;
                                                    clip: true;
                                                    Image {
                                                        source: seg.image;
                                                        width: 320px;
                                                        height: 320px;
                                                        image-fit: contain;
                                                    }
                                                    img-open-ta := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => { root.open-generated-image(seg.text); }
                                                    }
                                                }
                                                if seg.kind == "h1" || seg.kind == "h2" || seg.kind == "h3": Text {
                                                    text: seg.text;
                                                    color: m.role == "user" ? Palette.user-text : Palette.text-strong;
                                                    font-family: Palette.font-display;
                                                    font-size: seg.kind == "h1" ? 19px : (seg.kind == "h2" ? 16px : 14px);
                                                    font-weight: 600;
                                                    wrap: word-wrap;
                                                }
                                                // DS MarkdownContent, inline: bold, inline code,
                                                // ordered/unordered lists, and clickable links via
                                                // Slint's builtin CommonMark `StyledText` element
                                                // (P0 "inline markdown" — no more hand-rolled
                                                // bullet-only segmentation or `strip_inline`).
                                                if seg.kind == "markdown": StyledText {
                                                    text: seg.styled;
                                                    default-color: m.role == "user"
                                                        ? Palette.user-text
                                                        : Palette.assistant-text;
                                                    default-font-family: Palette.font-body;
                                                    default-font-size: 14px;
                                                    link-color: Palette.accent;
                                                    link-clicked(link) => { root.open-link(link); }
                                                }
                                            }
                                        }
                                    }
                                    // DS MessageActions: copy / regenerate / feedback.
                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: m.role == "user" ? end : start;
                                        // Mirrors the DS CodeBlock copy affordance above (flips
                                        // to a ✓ tick for a moment) — previously this button gave
                                        // no feedback at all, so a click looked like it might not
                                        // have registered.
                                        if m.role != "user" && m.text != "": copy-icon := Rectangle {
                                            width: 18px;
                                            height: 15px;
                                            property <bool> copied: false;
                                            accessible-role: button;
                                            accessible-label: copy-icon.copied ? "Copied" : "Copy";
                                            if !copy-icon.copied: Image {
                                                width: 12px;
                                                height: 12px;
                                                source: @image-url("../assets/icons/copy.svg");
                                                colorize: copy-ta.has-hover ? Palette.accent : Palette.text-subtle;
                                            }
                                            if copy-icon.copied: Text {
                                                text: "✓";
                                                color: Palette.accent;
                                                font-size: 12px;
                                            }
                                            Tooltip {
                                                text: @markdown("\{copy-icon.copied ? "Copied" : "Copy"}");
                                            }
                                            copy-msg-timer := Timer {
                                                interval: 1200ms;
                                                running: false;
                                                triggered => {
                                                    copy-icon.copied = false;
                                                    copy-msg-timer.running = false;
                                                }
                                            }
                                            copy-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    root.copy-message(m.text);
                                                    copy-icon.copied = true;
                                                    copy-msg-timer.running = true;
                                                }
                                            }
                                        }
                                        // Speak this reply aloud (text-to-speech). Previously a
                                        // bare 🔈/🔊 emoji with no label, easy to mistake for
                                        // something else next to the copy icon — now the real
                                        // DS icon plus a hover tooltip + accessible-label, same
                                        // pattern RailButton already uses. Shows accent while
                                        // busy and ignores further clicks so playback never
                                        // queues twice.
                                        if m.role != "user" && m.text != "": Rectangle {
                                            width: 18px;
                                            height: 15px;
                                            accessible-role: button;
                                            accessible-label: m.speaking ? "Speaking…" : "Read aloud";
                                            Image {
                                                width: 12px;
                                                height: 12px;
                                                source: Icons.volume-2;
                                                colorize: m.speaking
                                                    ? Palette.accent
                                                    : (speak-ta.has-hover ? Palette.accent : Palette.text-subtle);
                                            }
                                            Tooltip {
                                                text: @markdown("Read aloud");
                                            }
                                            speak-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    if !m.speaking {
                                                        root.speak-message(m.id, m.text);
                                                    }
                                                }
                                            }
                                        }
                                        // Regenerate (assistant turns).
                                        if m.role == "assistant" && (m.text != "" || m.stats != "") && !root.streaming: Rectangle {
                                            width: 18px;
                                            height: 15px;
                                            accessible-role: button;
                                            accessible-label: "Regenerate response";
                                            Image {
                                                width: 12px;
                                                height: 12px;
                                                source: @image-url("../assets/icons/retry.svg");
                                                colorize: retry-ta.has-hover ? Palette.accent : Palette.text-subtle;
                                            }
                                            Tooltip {
                                                text: @markdown("Regenerate response");
                                            }
                                            retry-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.regenerate(m.id); }
                                            }
                                        }
                                        // Feedback (assistant turns) — interaction-learning
                                        // signal capture. DS: monochrome, #f81a2c accent when
                                        // hovered or active.
                                        if m.role != "user" && m.text != "": Rectangle {
                                            width: 18px;
                                            height: 15px;
                                            accessible-role: button;
                                            accessible-label: "Good response";
                                            Image {
                                                width: 12px;
                                                height: 12px;
                                                source: @image-url("../assets/icons/thumb-up.svg");
                                                colorize: m.feedback == "thumbs_up"
                                                    ? Palette.accent
                                                    : (up-ta.has-hover ? Palette.accent : Palette.text-subtle);
                                            }
                                            Tooltip {
                                                text: @markdown("Good response");
                                            }
                                            up-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.message-feedback(m.id, "thumbs_up"); }
                                            }
                                        }
                                        if m.role != "user" && m.text != "": Rectangle {
                                            width: 18px;
                                            height: 15px;
                                            accessible-role: button;
                                            accessible-label: "Bad response";
                                            Image {
                                                width: 12px;
                                                height: 12px;
                                                source: @image-url("../assets/icons/thumb-down.svg");
                                                colorize: m.feedback == "thumbs_down"
                                                    ? Palette.accent
                                                    : (down-ta.has-hover ? Palette.accent : Palette.text-subtle);
                                            }
                                            Tooltip {
                                                text: @markdown("Bad response");
                                            }
                                            down-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.message-feedback(m.id, "thumbs_down"); }
                                            }
                                        }
                                        // Edit (user turns) — load back into the composer.
                                        // Gated on !root.streaming, matching Regenerate's own
                                        // gate: editing mid-stream armed a fork intent the
                                        // still-running generation's eventual persisted reply
                                        // knew nothing about, letting it attach to the wrong
                                        // (post-edit) branch once it finally landed.
                                        if m.role == "user" && !root.streaming: Rectangle {
                                            width: 18px;
                                            height: 15px;
                                            accessible-role: button;
                                            accessible-label: "Edit message";
                                            Image {
                                                width: 12px;
                                                height: 12px;
                                                source: @image-url("../assets/icons/edit.svg");
                                                colorize: edit-ta.has-hover ? Palette.accent : Palette.text-subtle;
                                            }
                                            Tooltip {
                                                text: @markdown("Edit message");
                                            }
                                            edit-ta := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.edit-message(m.text, m.id); }
                                            }
                                        }
                                        // Branch navigator (P0): `‹ i/n ›` switcher, shown only
                                        // when this message has sibling forks (a prior
                                        // edit/regenerate created an alternate turn here).
                                        // Switching reloads that sibling's own downstream
                                        // transcript — the abandoned-branch storage model
                                        // (`parent_id` + `pending_fork`) already exists; this is
                                        // the UI to see and move between the branches it creates.
                                        // Gated on !root.streaming: switching wholesale-replaces
                                        // the displayed transcript (`vm.set_vec`) while a still-
                                        // running generation keeps writing tokens into its own
                                        // captured row index — clicking mid-stream let a reply's
                                        // tokens land on a foreign bubble from the branch just
                                        // switched to.
                                        if m.branch-count > 1 && !root.streaming: HorizontalLayout {
                                            spacing: 2px;
                                            Rectangle {
                                                width: 14px;
                                                height: 15px;
                                                accessible-role: button;
                                                accessible-label: "Previous version";
                                                Text {
                                                    text: "‹";
                                                    color: prev-branch-ta.has-hover ? Palette.accent : Palette.text-subtle;
                                                    font-size: 13px;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                Tooltip {
                                                    text: @markdown("Previous version");
                                                }
                                                prev-branch-ta := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.switch-branch(m.id, -1); }
                                                }
                                            }
                                            Text {
                                                text: m.branch-index + "/" + m.branch-count;
                                                color: Palette.text-subtle;
                                                font-family: Palette.font-mono;
                                                font-size: 10px;
                                                vertical-alignment: center;
                                            }
                                            Rectangle {
                                                width: 14px;
                                                height: 15px;
                                                accessible-role: button;
                                                accessible-label: "Next version";
                                                Text {
                                                    text: "›";
                                                    color: next-branch-ta.has-hover ? Palette.accent : Palette.text-subtle;
                                                    font-size: 13px;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                Tooltip {
                                                    text: @markdown("Next version");
                                                }
                                                next-branch-ta := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.switch-branch(m.id, 1); }
                                                }
                                            }
                                        }
                                        // DS TokenMeter — generation speed/tokens.
                                        if m.stats != "": Text {
                                            text: m.stats;
                                            min-width: 0px;
                                            horizontal-stretch: 1;
                                            wrap: word-wrap;
                                            color: Palette.text-muted;
                                            font-family: Palette.font-mono;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // AI response state (DS AgentStatus): a live indicator
                            // while the model is generating, so the turn never looks
                            // stalled before the first token lands.
                            if root.session-loading || root.chat-operation != "": Text {
                                text: root.session-loading ? "Loading conversation..." : root.chat-operation;
                                color: Palette.text-muted;
                                font-size: 13px;
                            }
                            if root.session-error != "": VerticalLayout {
                                Banner { kind: "warning"; text: root.session-error; }
                                SmithButton { text: "Retry loading chat"; clicked => { root.select-session(root.selected-session); } }
                            }
                            if root.streaming: HorizontalLayout {
                                alignment: start;
                                spacing: 8px;
                                Rectangle {
                                    width: 7px;
                                    height: 7px;
                                    y: 3px;
                                    border-radius: 3.5px;
                                    background: Palette.accent;
                                    opacity: 0.45 + 0.55 * pulse.value;
                                    animate opacity { duration: 600ms; easing: ease-in-out; }
                                    pulse := Timer {
                                        interval: 600ms;
                                        running: root.streaming;
                                        property <float> value: 0;
                                        triggered => {
                                            self.value = self.value > 0.5 ? 0 : 1;
                                        }
                                    }
                                }
                                Text {
                                    text: "Smith is responding…";
                                    color: Palette.text-muted;
                                    font-family: Palette.font-mono;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Empty state — painted over the (empty) `chat-scroll`
                    // above when there are no messages yet.
                    if root.messages.length == 0: VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            alignment: center;
                            VerticalLayout {
                                alignment: center;
                                spacing: 12px;
                                HorizontalLayout {
                                    alignment: center;
                                    Image {
                                        source: @image-url("../assets/icon-256.png");
                                        width: 56px;
                                        height: 56px;
                                        opacity: 0.9;
                                    }
                                }
                                Text {
                                    text: "Ask Smith anything";
                                    color: Palette.text-strong;
                                    font-family: Palette.font-display;
                                    font-size: 20px;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Your AI runs entirely on this machine.";
                                    color: Palette.text-muted;
                                    font-family: Palette.font-body;
                                    font-size: 13px;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }

                    // "Jump to latest ↓" chip (P0 auto-scroll): appears only
                    // once the user has scrolled away from the bottom
                    // mid-transcript. Declared after `chat-scroll`, so it
                    // paints above it — a floating overlay anchored just
                    // above the composer. A real DS `SmithButton` (sharp
                    // 4px radius, secondary/outline kind) rather than a
                    // bespoke pill Rectangle — `radius-pill` is reserved for
                    // toggle/meter tracks per the DS spec, not buttons.
                    if !root.pinned-to-bottom && root.messages.length > 0: SmithButton {
                        x: (parent.width - self.width) / 2;
                        y: parent.height - self.height - 16px;
                        width: 168px;
                        text: "Jump to latest ↓";
                        kind: "secondary";
                        clicked => {
                            root.pinned-to-bottom = true;
                            chat-scroll.viewport-y = min(0px, chat-scroll.visible-height - chat-scroll.viewport-height);
                        }
                    }
                }

                // ---- composer ----
                Rectangle {
                    background: Palette.sunken;
                    VerticalLayout {
                        padding-left: 24px;
                        padding-right: 24px;
                        padding-top: 12px;
                        padding-bottom: 20px;

                        Rectangle {
                            border-radius: Palette.radius;
                            border-width: 2px;
                            border-color: composer-input.has-focus ? Palette.accent : Palette.border;
                            background: Palette.page;
                            animate border-color { duration: 120ms; }

                            VerticalLayout {
                                padding: 8px;
                                spacing: 6px;

                                if root.editing-message: HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "Editing an earlier message. Sending creates a new version.";
                                        color: Palette.text-muted;
                                        font-size: 12px;
                                        wrap: word-wrap;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    SmithButton {
                                        text: "Cancel edit";
                                        width: 110px;
                                        clicked => {
                                            root.composer-text = "";
                                            root.editing-message = false;
                                            root.filter-slash("");
                                        }
                                    }
                                }
                                // Attachment chip — shown when a file is attached.
                                if root.attachment-name != "": Rectangle {
                                    height: 28px;
                                    border-radius: Palette.radius;
                                    background: Palette.sunken;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 6px;
                                        spacing: 6px;
                                        Image {
                                            width: 13px;
                                            height: 13px;
                                            y: (parent.height - self.height) / 2;
                                            source: @image-url("../assets/icons/paperclip.svg");
                                            colorize: Palette.text-muted;
                                        }
                                        Text {
                                            text: root.attachment-name;
                                            color: Palette.text-body;
                                            font-family: Palette.font-mono;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        Rectangle {
                                            width: 20px;
                                            Icon {
                                                source: Icons.x;
                                                size: 12px;
                                                stroke: clear-touch.has-hover ? Palette.accent : Palette.text-subtle;
                                            }
                                            clear-touch := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.clear-attachment(); }
                                            }
                                        }
                                    }
                                }

                                // Pending-artifact chip — shown when an artifact was picked
                                // from the Artifacts picker (mutually exclusive with the file
                                // attachment chip above). Grows by one row for a Transcript
                                // pick, showing exactly one of three things depending on
                                // `pending-artifact-summary-state`: a "Generating summary…"
                                // notice while one's being auto-created, a plain note if none
                                // could be (no model loaded), or the Full transcript / Summary
                                // choice once ready — reuses `FormatTab`, the same small
                                // segmented toggle Transcribe's own view-format tabs use,
                                // rather than a bespoke control.
                                if root.pending-artifact-title != "": Rectangle {
                                    height: root.pending-artifact-summary-state == "" ? 28px : 62px;
                                    border-radius: Palette.radius;
                                    background: Palette.sunken;
                                    animate height { duration: 100ms; }
                                    VerticalLayout {
                                        padding-left: 10px;
                                        padding-right: 6px;
                                        padding-top: 4px;
                                        padding-bottom: 4px;
                                        spacing: 4px;
                                        HorizontalLayout {
                                            height: 20px;
                                            spacing: 6px;
                                            Icon { source: Icons.layers; size: 13px; stroke: Palette.text-muted; }
                                            Text {
                                                text: root.pending-artifact-title;
                                                color: Palette.text-body;
                                                font-family: Palette.font-mono;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                            Rectangle {
                                                width: 20px;
                                                Icon {
                                                    source: Icons.x;
                                                    size: 12px;
                                                    stroke: clear-artifact-touch.has-hover ? Palette.accent : Palette.text-subtle;
                                                }
                                                clear-artifact-touch := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { root.clear-pending-artifact(); }
                                                }
                                            }
                                        }
                                        if root.pending-artifact-summary-state == "generating": HorizontalLayout {
                                            height: 30px;
                                            Text {
                                                text: "Generating summary…";
                                                color: Palette.text-muted;
                                                font-family: Palette.font-body;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                        }
                                        if root.pending-artifact-summary-state == "unavailable": HorizontalLayout {
                                            height: 30px;
                                            Text {
                                                text: "No summary available (no model loaded)";
                                                color: Palette.text-subtle;
                                                font-family: Palette.font-body;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                        if root.pending-artifact-summary-state == "ready": HorizontalLayout {
                                            height: 30px;
                                            spacing: 6px;
                                            FormatTab {
                                                label: "Full transcript";
                                                token: "full";
                                                active: !root.pending-artifact-use-summary;
                                                chosen(t) => { root.pending-artifact-use-summary = false; }
                                            }
                                            FormatTab {
                                                label: "Summary";
                                                token: "summary";
                                                active: root.pending-artifact-use-summary;
                                                chosen(t) => { root.pending-artifact-use-summary = true; }
                                            }
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                    }
                                }

// Slash-command autocomplete popup (P4 "Wire the slash-command
                                // autocomplete popup"): live suggestions for the `/token`
                                // currently being typed. Click a row, or use ↑/↓ + Tab, to
                                // accept a match — replaces the composer with `/name ` ready
                                // for the argument. `smith_core::slash::match_slash` already
                                // gates this to "leading slash, no space typed yet", so it only
                                // ever shows while a command name is actively being typed.
                                if root.slash-matches.length > 0: Rectangle {
                                    border-radius: Palette.radius;
                                    border-width: 1px;
                                    border-color: Palette.border;
                                    background: Palette.sunken;
                                    height: slash-lay.preferred-height + 8px;
                                    slash-lay := VerticalLayout {
                                        height: self.preferred-height;
                                        x: 4px;
                                        y: 4px;
                                        width: parent.width - 8px;
                                        for m[i] in root.slash-matches: Rectangle {
                                            height: 26px;
                                            border-radius: 4px;
                                            background: i == root.slash-selected ? Palette.hover : transparent;
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                spacing: 8px;
                                                Text {
                                                    text: "/" + m.name;
                                                    color: Palette.accent;
                                                    font-family: Palette.font-mono;
                                                    font-size: 12px;
                                                    font-weight: 600;
                                                    vertical-alignment: center;
                                                }
                                                Text {
                                                    text: m.description;
                                                    color: Palette.text-muted;
                                                    font-family: Palette.font-body;
                                                    font-size: 11.5px;
                                                    vertical-alignment: center;
                                                    horizontal-stretch: 1;
                                                    overflow: elide;
                                                }
                                            }
                                            TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => { root.pick-slash(m.name); }
                                            }
                                        }
                                    }
                                }

                                // Multi-line auto-grow input (DS PromptComposer):
                                // Enter sends; Shift+Enter inserts a newline; the box
                                // grows with content up to a cap, then scrolls.
                                Rectangle {
                                    clip: true;
                                    height: min(140px, max(22px, composer-input.preferred-height));
                                    composer-input := TextInput {
                                        accessible-label: "Message Smith";
                                        accessible-placeholder-text: "Message Smith…";
                                        width: parent.width;
                                        single-line: false;
                                        wrap: word-wrap;
                                        text <=> root.composer-text;
                                        font-family: Palette.font-body;
                                        font-size: 15px;
                                        color: Palette.text-strong;
                                        key-pressed(event) => {
                                            // ↑/↓ move the highlighted popup row instead of the
                                            // text cursor while suggestions are showing — before
                                            // this there was no keyboard way to reach anything
                                            // but the top match. Only a bare arrow key is
                                            // intercepted: Shift/Ctrl/Alt+arrow are left alone so
                                            // selection-extend / word-jump still work on a
                                            // multi-line slash-command token while the popup
                                            // happens to be showing.
                                            if (event.text == Key.DownArrow && root.slash-matches.length > 0
                                                && !event.modifiers.shift && !event.modifiers.control
                                                && !event.modifiers.alt && !event.modifiers.meta) {
                                                root.slash-nav(1);
                                                return accept;
                                            }
                                            if (event.text == Key.UpArrow && root.slash-matches.length > 0
                                                && !event.modifiers.shift && !event.modifiers.control
                                                && !event.modifiers.alt && !event.modifiers.meta) {
                                                root.slash-nav(-1);
                                                return accept;
                                            }
                                            // Tab accepts the highlighted suggestion while the
                                            // popup is showing, instead of moving focus away.
                                            if (event.text == Key.Tab && root.slash-matches.length > 0) {
                                                root.pick-slash(root.slash-matches[root.slash-selected].name);
                                                return accept;
                                            }
                                            // Mirrors the Send/Stop button's own streaming
                                            // branch exactly (app-window.slint's send-btn):
                                            // Enter is the composer's primary-action key, so
                                            // it must track whatever that action currently is.
                                            // Previously this branch always called `send`
                                            // unconditionally — pressing Enter while a reply
                                            // was still streaming silently started a SECOND,
                                            // overlapping turn (the button correctly became
                                            // "Stop" instead, but Enter never got the memo),
                                            // which could mis-attribute a reply to the wrong
                                            // question once both turns' writes interleaved.
                                            if (event.text == Key.Return && !event.modifiers.shift) {
                                                if (root.streaming) {
                                                    root.stop();
                                                } else if (root.can-send) {
                                                    root.send(root.composer-text);
                                                    root.composer-text = "";
                                                }
                                                return accept;
                                            }
                                            return reject;
                                        }
                                    }
                                    if root.composer-text == "": Text {
                                        x: 0;
                                        width: parent.width;
                                        horizontal-alignment: left;
                                        vertical-alignment: center;
                                        text: "Message Smith…";
                                        color: Palette.text-subtle;
                                        font-family: Palette.font-body;
                                        font-size: 15px;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;
                                    height: 36px;

                                    // Attach a file (document / image) to the message.
                                    Rectangle {
                                        width: 36px;
                                        height: 36px;
                                        border-radius: Palette.radius;
                                        background: attach-touch.has-hover ? Palette.hover : transparent;
                                        Icon {
                                            source: Icons.paperclip;
                                            size: 17px;
                                            stroke: Palette.text-muted;
                                        }
                                        attach-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.attach-file(); }
                                        }
                                    }

                                    // Artifacts picker — attach a recent artifact (transcript,
                                    // extracted document, or generated content) to the next
                                    // message instead of a fresh file.
                                    artifact-picker-btn := Rectangle {
                                        changed absolute-position => {
                                            root.artifact-anchor-x = self.absolute-position.x;
                                            root.artifact-anchor-y = self.absolute-position.y;
                                        }
                                        width: 36px;
                                        height: 36px;
                                        border-radius: Palette.radius;
                                        background: root.artifact-picker-open || artifact-picker-touch.has-hover ? Palette.hover : transparent;
                                        Icon {
                                            source: Icons.layers;
                                            size: 17px;
                                            stroke: Palette.text-muted;
                                        }
                                        artifact-picker-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.artifact-anchor-x = artifact-picker-btn.absolute-position.x;
                                                root.artifact-anchor-y = artifact-picker-btn.absolute-position.y;
                                                root.model-open = false;
                                                root.open-artifact-picker();
                                            }
                                        }
                                    }

                                    // Voice input — record + transcribe into the composer.
                                    Rectangle {
                                        width: 36px;
                                        height: 36px;
                                        border-radius: Palette.radius;
                                        background: root.recording
                                            ? Palette.accent
                                            : (mic-touch.has-hover ? Palette.hover : transparent);
                                        animate background { duration: 120ms; }
                                        Image {
                                            width: 17px;
                                            height: 17px;
                                            source: @image-url("../assets/icons/mic.svg");
                                            colorize: root.recording ? Palette.white : Palette.text-muted;
                                        }
                                        mic-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.voice-input(); }
                                        }
                                    }

                                    // Tool-mode toggle (P0): an explicit, visible switch for
                                    // whether this turn can call tools — decoupled from the
                                    // Agents editor's "Tools" checkbox. The red fill IS the
                                    // active indicator (mirrors the mic button's recording
                                    // state above).
                                    tools-btn := Rectangle {
                                        accessible-role: button;
                                        accessible-label: root.composer-tools
                                            ? "Tools on for this chat. Click to turn off."
                                            : "Tools off for this chat. Click to turn on.";
                                        accessible-action-default => {
                                            root.composer-tools = !root.composer-tools;
                                        }
                                        width: 36px;
                                        height: 36px;
                                        border-radius: Palette.radius;
                                        background: root.composer-tools
                                            ? Palette.accent
                                            : (tools-touch.has-hover ? Palette.hover : transparent);
                                        animate background { duration: 120ms; }
                                        Text {
                                            text: "🔧";
                                            font-size: 15px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        tools-touch := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.composer-tools = !root.composer-tools; }
                                        }
                                    }

                                    // Hint: the model is chosen from the selector in
                                    // the header (top-right).
                                    if !root.compact-layout || root.recording: Text {
                                        text: root.recording ? "Recording… click mic to stop" : "Enter to send · Shift+Enter for newline";
                                        color: root.recording ? Palette.accent : Palette.text-subtle;
                                        font-family: Palette.font-mono;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }

                                    Rectangle { horizontal-stretch: 1; }

                                    // Send / Stop button — one control whose role/label
                                    // flips with `streaming` (it's literally the same
                                    // hit target acting as Stop while generating).
                                    send-btn := Rectangle {
                                        accessible-role: button;
                                        accessible-label: root.streaming ? "Stop generating" : "Send message";
                                        accessible-enabled: root.streaming || (root.can-send && root.composer-text != "");
                                        accessible-action-default => {
                                            if (root.streaming) {
                                                root.stop();
                                            } else if (root.can-send) {
                                                root.send(root.composer-text);
                                                root.composer-text = "";
                                            }
                                        }
                                        width: 36px;
                                        height: 36px;
                                        border-radius: Palette.radius;
                                        // DS: accent when there is text to send, muted
                                        // when empty, black square while streaming.
                                        opacity: root.can-send || root.streaming ? 1 : 0.4;
                                        background: root.streaming
                                            ? Palette.black
                                            : (root.composer-text == ""
                                                ? Palette.muted
                                                : (send-touch.has-hover ? Palette.accent-hover : Palette.accent));
                                        animate background { duration: 120ms; }
                                        Image {
                                            source: root.streaming
                                                ? @image-url("../assets/icons/stop.svg")
                                                : @image-url("../assets/icons/send.svg");
                                            width: 18px;
                                            height: 18px;
                                            colorize: (root.streaming || root.composer-text != "")
                                                ? Palette.white
                                                : Palette.text-subtle;
                                        }
                                        send-touch := TouchArea {
                                            enabled: root.streaming || root.can-send;
                                            mouse-cursor: pointer;
                                            clicked => {
                                                if (root.streaming) {
                                                    root.stop();
                                                } else if (root.can-send) {
                                                    root.send(root.composer-text);
                                                    root.composer-text = "";
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ============================ models view =============================
        if root.active-view == 1: ModelsView {
            horizontal-stretch: 1;
            models: root.model-rows;
            all-models <=> root.all-model-rows;
            search-text <=> root.model-search;
            searching: root.model-searching;
            search-error: root.model-search-error;
            default-model: root.default-model;
            default-model-missing: root.default-model-missing;
            search(q) => {
                root.search-models(q);
            }
            cancel-download(id) => { root.cancel-download-model(id); }
            download(id) => {
                root.download-model(id);
            }
            delete(id) => {
                root.delete-model(id);
            }
            set-default(id) => {
                root.set-default-model(id);
            }
            refresh => {
                root.refresh-models();
            }
        }

        // =========================== settings view ============================
        if root.active-view == 2: SettingsView {
            horizontal-stretch: 1;
            active-tab <=> root.settings-tab;
            appearance <=> root.appearance;
            start-at-login <=> root.start-at-login;
            tray-only <=> root.tray-only;
            telemetry-enabled <=> root.telemetry-enabled;
            collect-endpoint <=> root.collect-endpoint;
            collect-token <=> root.collect-token;
            collect-error: root.collect-error;
            crash-reporting-enabled <=> root.crash-reporting-enabled;
            port-text <=> root.port-text;
            port-error: root.port-error;
            restart-now(id) => { root.restart-now(id); }
            expose-to-network <=> root.expose-to-network;
            node-address: root.node-address;
            node-access-key: root.node-access-key;
            access-key-error: root.access-key-error;
            restart-error-port: root.restart-error-port;
            restart-error-network: root.restart-error-network;
            restart-error-execution-provider: root.restart-error-execution-provider;
            restart-error-computer-use: root.restart-error-computer-use;
            restart-error-providers: root.restart-error-providers;
            generate-access-key => { root.generate-access-key(); }
            copy-message(v) => { root.copy-message(v); }
            models: root.models;
            default-model <=> root.default-model;
            models-dir: root.models-dir;
            change-models-dir => {
                root.change-models-dir();
            }
            artifacts-dir: root.artifacts-dir;
            artifacts-dir-status: root.artifacts-dir-status;
            artifacts-dir-busy: root.artifacts-dir-busy;
            artifacts-dir-error: root.artifacts-dir-error;
            artifacts-dir-progress: root.artifacts-dir-progress;
            artifacts-dir-pending: root.artifacts-dir-pending;
            artifacts-dir-pending-free: root.artifacts-dir-pending-free;
            artifacts-dir-pending-low-disk: root.artifacts-dir-pending-low-disk;
            change-artifacts-dir => {
                root.change-artifacts-dir();
            }
            confirm-artifacts-move => {
                root.confirm-artifacts-move();
            }
            cancel-artifacts-move => {
                root.cancel-artifacts-move();
            }
            execution-provider <=> root.execution-provider;
            reasoning-effort <=> root.reasoning-effort;
            voice-language <=> root.voice-language;
            consolidate-enabled <=> root.consolidate-enabled;
            reflect-enabled <=> root.reflect-enabled;
            soul-evolve-enabled <=> root.soul-evolve-enabled;
            memory-summarizer-enabled <=> root.memory-summarizer-enabled;
            metrics-summary <=> root.metrics-summary;
            metrics-rows <=> root.metrics-rows;
            app-version: root.app-version;
            hardware-summary: root.hardware-summary;
            diagnostics-exporting <=> root.diagnostics-exporting;
            export-diagnostics => {
                root.export-diagnostics();
            }
            privacy-mode <=> root.privacy-mode;
            privacy-test-input <=> root.privacy-test-input;
            privacy-detections: root.privacy-detections;
            privacy-tested: root.privacy-tested;
            computer-use-policy <=> root.computer-use-policy;
            sandbox-status: root.sandbox-status;
            sandbox-provisioning: root.sandbox-provisioning;
            test-redaction => {
                root.test-redaction();
            }
            provision-sandbox => {
                root.provision-sandbox();
            }
            openai-key <=> root.openai-key;
            anthropic-key <=> root.anthropic-key;
            gemini-key <=> root.gemini-key;
            openrouter-key <=> root.openrouter-key;
            lmstudio-key <=> root.lmstudio-key;
            local-openai-endpoint <=> root.local-openai-endpoint;
            local-openai-error: root.local-openai-error;
            winml-key <=> root.winml-key;
            winml-endpoint <=> root.winml-endpoint;
            setting-changed => {
                root.setting-changed();
            }
            refresh-metrics => {
                root.refresh-metrics();
            }
            // Metrics tab (index 6) used to stay stale until the user
            // clicked Refresh manually — auto-refresh the moment it opens.
            select-tab(i) => {
                if i == 6 {
                    root.refresh-metrics();
                }
            }
            open-model-browser => {
                root.active-view = 1;
            }
        }

        // ============================ agents view =============================
        if root.active-view == 3: AgentsAutonomyView {
            horizontal-stretch: 1;
            sub-view <=> root.autonomy-sub-view;
            ext-tab <=> root.autonomy-ext-tab;
            // --- Agents (passed through to the embedded AgentsView) ---
            agents: root.agents;
            models: root.models;
            agent-name <=> root.agent-name;
            agent-prompt <=> root.agent-prompt;
            agent-model <=> root.agent-model;
            agent-working-dir <=> root.agent-working-dir;
            agent-soul <=> root.agent-soul;
            agent-memory <=> root.agent-memory;
            agent-tools <=> root.agent-tools;
            agent-computer-use <=> root.agent-computer-use;
            agent-image-generation <=> root.agent-image-generation;
            global-computer-use-policy: root.computer-use-policy;
            agent-signals: root.agent-signals;
            agent-lessons: root.agent-lessons;
            agent-soul-current: root.agent-soul-current;
            agent-challenger-summary: root.agent-challenger-summary;
            agent-evolve-state: root.agent-evolve-state;
            agent-evolve-is-error: root.agent-evolve-is-error;
            evolve-agent-now => { root.evolve-agent-now(); }
            editing-agent <=> root.editing-agent;
            agent-saving: root.agent-saving;
            agent-loading: root.agent-loading;
            agent-deleting: root.agent-deleting;
            agent-save-status: root.agent-save-status;
            agent-save-is-error: root.agent-save-is-error;
            agent-run-input <=> root.agent-run-input;
            agent-run-state: root.agent-run-state;
            agent-run-result: root.agent-run-result;
            save-agent => { root.save-agent(); }
            delete-agent(id) => { root.delete-agent(id); }
            new-agent => { root.new-agent(); }
            select-agent(id) => { root.select-agent(id); }
            run-agent-foreground => { root.run-agent-foreground(); }
            run-agent-background => { root.run-agent-background(); }
            open-runs => {
                root.active-view = 6;
                root.activity-sub-view = 0;
                root.activity-refresh();
            }
            // --- Autonomy (relocated out of Settings) ---
            agent-names: root.agent-names;
            mcp-providers: root.mcp-providers;
            mcp-name <=> root.mcp-name;
            mcp-command <=> root.mcp-command;
            mcp-args <=> root.mcp-args;
            mcp-status: root.mcp-status;
            mcp-adding: root.mcp-adding;
            add-mcp => { root.add-mcp(); }
            remove-mcp(id) => { root.remove-mcp(id); }
            schedules: root.schedules;
            sched-name <=> root.sched-name;
            sched-agent <=> root.sched-agent;
            sched-cron <=> root.sched-cron;
            sched-prompt <=> root.sched-prompt;
            sched-cron-error: root.sched-cron-error;
            sched-next-fires: root.sched-next-fires;
            sched-status: root.sched-status;
            sched-adding: root.sched-adding;
            validate-cron(t) => { root.validate-cron(t); }
            add-schedule => { root.add-schedule(); }
            remove-schedule(id) => { root.remove-schedule(id); }
            toggle-schedule(id) => { root.toggle-schedule(id); }
            watchers: root.watchers;
            watch-name <=> root.watch-name;
            watch-agent <=> root.watch-agent;
            watch-path <=> root.watch-path;
            watch-kind <=> root.watch-kind;
            watch-recursive <=> root.watch-recursive;
            watch-status: root.watch-status;
            watch-adding: root.watch-adding;
            add-watcher => { root.add-watcher(); }
            remove-watcher(id) => { root.remove-watcher(id); }
            toggle-watcher(id) => { root.toggle-watcher(id); }
            // Memory moved to the Activity hub (P4) — bound there instead.
            skills: root.skills;
            skill-name <=> root.skill-name;
            skill-category <=> root.skill-category;
            skill-desc <=> root.skill-desc;
            skill-instructions <=> root.skill-instructions;
            skill-enabled <=> root.skill-enabled;
            skill-status: root.skill-status;
            skill-adding: root.skill-adding;
            add-skill => { root.add-skill(); }
            remove-skill(id) => { root.remove-skill(id); }
            toggle-skill(id) => { root.toggle-skill(id); }
            methods: root.methods;
            method-name <=> root.method-name;
            method-desc <=> root.method-desc;
            method-instructions <=> root.method-instructions;
            method-enabled <=> root.method-enabled;
            method-status: root.method-status;
            method-adding: root.method-adding;
            add-method => { root.add-method(); }
            remove-method(id) => { root.remove-method(id); }
            toggle-method(id) => { root.toggle-method(id); }
            recipes: root.recipes;
            recipe-name <=> root.recipe-name;
            recipe-desc <=> root.recipe-desc;
            recipe-command <=> root.recipe-command;
            recipe-params <=> root.recipe-params;
            recipe-enabled <=> root.recipe-enabled;
            recipe-params-error: root.recipe-params-error;
            recipe-status: root.recipe-status;
            recipe-adding: root.recipe-adding;
            add-recipe => { root.add-recipe(); }
            remove-recipe(id) => { root.remove-recipe(id); }
            toggle-recipe(id) => { root.toggle-recipe(id); }
        }

        // ====== Activity hub (P4): Runs + Artifacts + Transcribe + Memory ======
        // Artifacts and Transcribe used to be standalone rail destinations
        // (active-view 5/4); they're now sub-tabs inside this hub instead —
        // the properties/callbacks below are unchanged 1:1 from when they
        // were bound directly here, just routed through ActivityView's
        // pass-through props so the Rust side (lib.rs/bridge.rs) needs no
        // changes at all.
        if root.active-view == 6: ActivityView {
            compact: root.compact-layout;
            horizontal-stretch: 1;
            sub-view <=> root.activity-sub-view;
            tasks: root.activity-tasks;
            selected-task <=> root.activity-selected-task;
            clarify-reply <=> root.activity-clarify-reply;
            detail: root.activity-detail;
            has-selection: root.activity-has-selection;
            refresh => {
                root.activity-refresh();
            }
            select-task(id) => {
                root.activity-select-task(id);
            }
            cancel-task(id) => {
                root.activity-cancel-task(id);
            }
            answer-clarification(id, answer) => {
                root.activity-answer-clarification(id, answer);
            }
            // --- Artifacts ---
            artifacts-list: root.artifacts-list;
            artifacts-status <=> root.artifacts-status;
            artifacts-viewer-open <=> root.artifacts-viewer-open;
            artifacts-viewer-title <=> root.artifacts-viewer-title;
            artifacts-viewer-text <=> root.artifacts-viewer-text;
            artifacts-viewer-is-image <=> root.artifacts-viewer-is-image;
            artifacts-viewer-image <=> root.artifacts-viewer-image;
            artifacts-viewer-artifact-id <=> root.artifacts-viewer-artifact-id;
            artifacts-viewer-busy <=> root.artifacts-viewer-busy;
            artifacts-viewer-opening <=> root.artifacts-viewer-opening;
            artifacts-renaming-id <=> root.artifacts-renaming-id;
            artifacts-rename-text <=> root.artifacts-rename-text;
            artifacts-refresh => { root.artifacts-refresh(); }
            artifacts-register-folder => { root.artifacts-register-folder(); }
            artifacts-open(id) => { root.artifacts-open(id); }
            artifacts-delete(id) => { root.artifacts-delete(id); }
            artifacts-rename(id, title) => { root.artifacts-rename(id, title); }
            artifacts-edit-image(id, prompt) => { root.artifacts-edit-image(id, prompt); }
            artifacts-variation-image(id) => { root.artifacts-variation-image(id); }
            artifacts-upscale-image(id) => { root.artifacts-upscale-image(id); }
            // --- Transcribe ---
            transcribe-source <=> root.transcribe-source;
            transcribe-lang <=> root.transcribe-lang;
            transcribe-format <=> root.transcribe-format;
            transcribe-output: root.transcribe-output;
            transcribe-status <=> root.transcribe-status;
            transcribe-busy <=> root.transcribe-busy;
            transcribe-has-result <=> root.transcribe-has-result;
            transcribe-artifacts: root.transcribe-artifacts;
            transcribe-selected-artifact <=> root.transcribe-selected-artifact;
            transcribe-pick-file => { root.transcribe-pick-file(); }
            transcribe-start => { root.transcribe-start(); }
            transcribe-summarize => { root.transcribe-summarize(); }
            transcribe-save-artifact => { root.transcribe-save-artifact(); }
            transcribe-load-artifact(id) => { root.transcribe-load-artifact(id); }
            transcribe-delete-artifact(id) => { root.transcribe-delete-artifact(id); }
            transcribe-save => { root.transcribe-save(); }
            transcribe-copy => { root.transcribe-copy(); }
            // --- Memory (moved from Agents & Autonomy) ---
            memory-rows: root.memory-rows;
            memory-query <=> root.memory-query;
            memory-searching: root.memory-searching;
            search-memory => { root.search-memory(); }
            memory-browsing: root.memory-browsing;
            browse-memory => { root.browse-memory(); }
            delete-memory(id) => { root.delete-memory(id); }
            toggle-pin-memory(id) => { root.toggle-pin-memory(id); }
        }
    }
    }
    }

    // ===== model dropdown — an inline overlay (not a PopupWindow), so it's
    // fully position-controlled and renders above everything. =====
    if root.model-open: Rectangle {
        width: 100%;
        height: 100%;
        // Click-anywhere-outside to dismiss.
        TouchArea {
            clicked => {
                root.model-open = false;
            }
        }
        // Panel anchored under the header model pill (top-right).
        Rectangle {
            width: min(360px, root.width - 24px);
            x: clamp(root.model-anchor-x, 12px, root.width - self.width - 12px);
            y: clamp(root.model-anchor-y + 6px, 12px, root.height - self.height - 12px);
            // A floor keeps this from collapsing to an unreadable 8px sliver
            // at models.length == 0 (a real reachable state: a fresh install
            // whose wizard download was skipped or failed) — the same bug
            // class the composer's Artifacts picker had, fixed the same way.
            height: min(max(min(root.models.length * 34px + 8px, 360px), 64px), root.height - 24px);
            border-radius: Palette.radius;
            border-width: 1px;
            border-color: Palette.border;
            background: Palette.raised;
            drop-shadow-color: Palette.black.with-alpha(0.4);
            drop-shadow-blur: 16px;
            clip: true;
            if root.models.length == 0: Text {
                x: 12px;
                y: 10px;
                width: parent.width - 24px;
                text: "No models yet — go to Settings → Models to download one.";
                color: Palette.text-muted;
                font-family: Palette.font-body;
                font-size: 12px;
                wrap: word-wrap;
            }
            if root.models.length > 0: ListView {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                for m in root.models: Rectangle {
                    height: 34px;
                    border-radius: Palette.radius;
                    background: ov-opt.has-hover ? Palette.sunken : transparent;
                    ov-opt := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.select-model(m);
                            root.model-open = false;
                        }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        Text {
                            text: m;
                            color: m == root.active-model ? Palette.text-strong : Palette.text-body;
                            font-family: Palette.font-mono;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }

    // ===== composer Artifacts picker — recent artifacts by title (#44) =====
    if root.artifact-picker-open: Rectangle {
        width: 100%;
        height: 100%;
        // Click-anywhere-outside to dismiss.
        TouchArea {
            clicked => {
                root.artifact-picker-open = false;
            }
        }
        // Panel anchored just above the composer's Artifacts button.
        Rectangle {
            width: min(360px, root.width - 24px);
            x: clamp(root.artifact-anchor-x, 12px, root.width - self.width - 12px);
            y: clamp(root.artifact-anchor-y - self.height - 8px, 12px, root.height - self.height - 12px);
            // A floor of 64px keeps the empty-state message ("No artifacts
            // yet…", which wraps to 2 lines) from being clipped — the plain
            // `length * 48px + 8px` formula collapses to 8px at length == 0,
            // rendering as an unreadable sliver instead of the message.
            height: min(max(min(root.composer-artifacts.length * 48px + 8px, 300px), 64px), root.height - 24px);
            border-radius: Palette.radius;
            border-width: 1px;
            border-color: Palette.border;
            background: Palette.raised;
            drop-shadow-color: Palette.black.with-alpha(0.4);
            drop-shadow-blur: 16px;
            clip: true;
            if root.composer-artifacts.length == 0: Text {
                x: 12px;
                y: 10px;
                text: "No artifacts yet — attach a file in chat or register a folder in Artifacts.";
                color: Palette.text-muted;
                font-family: Palette.font-body;
                font-size: 12px;
                wrap: word-wrap;
                width: parent.width - 24px;
            }
            if root.composer-artifacts.length > 0: ListView {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                for a in root.composer-artifacts: Rectangle {
                    height: 44px;
                    border-radius: Palette.radius;
                    background: pick-opt.has-hover ? Palette.sunken : transparent;
                    pick-opt := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.pick-artifact(a.id);
                        }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: a.title;
                                color: Palette.text-strong;
                                font-family: Palette.font-body;
                                font-size: 12px;
                                font-weight: 600;
                                overflow: elide;
                            }
                            Text {
                                text: a.subtitle;
                                color: Palette.text-muted;
                                font-family: Palette.font-mono;
                                font-size: 10px;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }
    }

    // ===== welcome / first-run setup overlay (topmost) =====
    if root.show-welcome: Rectangle {
        width: 100%;
        height: 100%;
        background: Palette.black.with-alpha(0.8);
        // Swallow clicks so the app behind the modal isn't interactable.
        TouchArea {}
        Rectangle {
            width: min(root.width - 80px, 660px);
            height: min(root.height - 64px, 760px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Palette.radius;
            background: Palette.page;
            border-width: 1px;
            border-color: Palette.border;
            drop-shadow-color: Palette.black.with-alpha(0.53);
            drop-shadow-blur: 28px;
            clip: true;
            VerticalLayout {
                padding: 26px;
                spacing: 14px;
                Text {
                    text: "Welcome to Smith";
                    color: Palette.text-strong;
                    font-family: Palette.font-display;
                    font-size: 24px;
                    font-weight: 600;
                }
                Text {
                    text: "Smith runs AI on your own machine. Pick where to keep models, grab one that fits your hardware, and install the optional tools you want — everything below is one click.";
                    color: Palette.text-muted;
                    font-family: Palette.font-body;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 12px;

                        // hardware
                        Rectangle {
                            height: 64px;
                            border-radius: Palette.radius;
                            background: Palette.sunken;
                            border-width: 1px;
                            border-color: Palette.border;
                            VerticalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: center;
                                spacing: 3px;
                                Text {
                                    text: "Detected hardware";
                                    color: Palette.text-subtle;
                                    font-family: Palette.font-body;
                                    font-size: 11px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: root.welcome-hw;
                                    color: Palette.text-body;
                                    font-family: Palette.font-mono;
                                    font-size: 13px;
                                    overflow: elide;
                                }
                            }
                        }

                        // model storage location
                        Rectangle {
                            border-radius: Palette.radius;
                            background: Palette.raised;
                            border-width: 1px;
                            border-color: Palette.border;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;
                                Text {
                                    text: "Model storage location";
                                    color: Palette.text-strong;
                                    font-family: Palette.font-body;
                                    font-size: 14px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: "Models can be many GB. Keep them off the system drive if it's tight.";
                                    color: Palette.text-muted;
                                    font-family: Palette.font-body;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 34px;
                                        border-radius: 4px;
                                        background: Palette.sunken;
                                        border-width: 1px;
                                        border-color: Palette.border;
                                        Text {
                                            x: 10px;
                                            width: parent.width - 20px;
                                            vertical-alignment: center;
                                            text: root.welcome-models-dir;
                                            color: Palette.text-body;
                                            font-family: Palette.font-mono;
                                            font-size: 11px;
                                            overflow: elide;
                                        }
                                    }
                                    SmithButton {
                                        text: "Change…";
                                        kind: "secondary";
                                        width: 110px;
                                        clicked => { root.welcome-pick-dir(); }
                                    }
                                }
                                if root.welcome-disk-free != "": Text {
                                    text: root.welcome-disk-free;
                                    color: Palette.text-subtle;
                                    font-family: Palette.font-body;
                                    font-size: 11px;
                                }
                            }
                        }

                        // recommended chat model
                        Rectangle {
                            border-radius: Palette.radius;
                            background: Palette.raised;
                            border-width: 1px;
                            border-color: Palette.border;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 6px;
                                Text {
                                    text: "Recommended model";
                                    color: Palette.text-strong;
                                    font-family: Palette.font-body;
                                    font-size: 14px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: root.welcome-model-label;
                                    color: Palette.accent;
                                    font-family: Palette.font-body;
                                    font-size: 13px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: root.welcome-model-detail;
                                    color: Palette.text-muted;
                                    font-family: Palette.font-body;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                if root.welcome-model-low-disk: Text {
                                    text: "⚠ This is bigger than the free space on that drive — pick a smaller model below or change the storage location above.";
                                    color: Palette.red;
                                    font-family: Palette.font-body;
                                    font-size: 11px;
                                    wrap: word-wrap;
                                }
                                if !root.welcome-model-downloading && root.welcome-model-fallback-id != "": TouchArea {
                                    height: 16px;
                                    mouse-cursor: pointer;
                                    clicked => { root.welcome-use-fallback-model(); }
                                    Text {
                                        text: "Use a smaller, faster download instead: " + root.welcome-model-fallback-label;
                                        color: Palette.accent;
                                        font-family: Palette.font-body;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                }
                                // While downloading: a progress bar + byte status, mirroring
                                // the Models view's per-row bar (models.slint).
                                if root.welcome-model-downloading: VerticalLayout {
                                    SmithButton {
                                        text: "Cancel download";
                                        kind: "secondary";
                                        clicked => { root.cancel-download-model(root.welcome-model-id); }
                                    }
                                    spacing: 4px;
                                    Text {
                                        text: root.welcome-model-status;
                                        color: Palette.text-muted;
                                        font-family: Palette.font-mono;
                                        font-size: 10px;
                                    }
                                    Rectangle {
                                        height: 6px;
                                        border-radius: 3px;
                                        background: Palette.border;
                                        Rectangle {
                                            x: 0;
                                            height: parent.height;
                                            width: parent.width * clamp(root.welcome-model-progress, 0.0, 1.0);
                                            border-radius: 3px;
                                            background: Palette.accent;
                                            animate width { duration: 200ms; }
                                        }
                                    }
                                }
                                if !root.welcome-model-downloading: HorizontalLayout {
                                    spacing: 10px;
                                    Text {
                                        vertical-alignment: center;
                                        text: root.welcome-model-status;
                                        color: Palette.text-muted;
                                        font-family: Palette.font-body;
                                        font-size: 12px;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    SmithButton {
                                        text: root.welcome-model-installed ? "Use for chat" : "Download";
                                        kind: "primary";
                                        width: 140px;
                                        clicked => { root.welcome-download-model(); }
                                    }
                                }
                            }
                        }

                        Text {
                            text: "Optional components";
                            color: Palette.text-strong;
                            font-family: Palette.font-body;
                            font-size: 13px;
                            font-weight: 600;
                        }
                        SetupRow {
                            title: "Speech-to-text model (voice / transcription)";
                            status: root.welcome-voice-status;
                            action: "Prepare";
                            act => { root.welcome-prepare-voice(); }
                        }
                        SetupRow {
                            title: "ffmpeg (audio/video file + URL transcription)";
                            status: root.welcome-ffmpeg-status;
                            action: "Install";
                            manual-command: "winget install --id Gyan.FFmpeg -e";
                            act => { root.welcome-install-ffmpeg(); }
                            copy-command(v) => { root.copy-message(v); }
                        }
                        SetupRow {
                            title: "WSL2 sandbox (safe tool / shell execution)";
                            status: root.welcome-wsl-status;
                            action: "Set up";
                            manual-command: "wsl --install";
                            act => { root.welcome-install-wsl(); }
                            copy-command(v) => { root.copy-message(v); }
                        }

                        // Telemetry consent (P4 "First-run polish"): a real,
                        // distinct decision on this screen — not just a
                        // Settings checkbox nobody sees until they go looking
                        // for it. Off is pre-selected and stays off unless
                        // you actively pick On.
                        Rectangle {
                            border-radius: Palette.radius;
                            background: Palette.raised;
                            border-width: 1px;
                            border-color: Palette.border;
                            VerticalLayout {
                                padding: 14px;
                                spacing: 8px;
                                Text {
                                    text: "Anonymous usage telemetry";
                                    color: Palette.text-strong;
                                    font-family: Palette.font-body;
                                    font-size: 14px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: "Smith is local-first: nothing leaves this machine either way. If you opt in, non-identifying usage counts (never message content) can help improve Smith — you can change this later in Settings → Privacy.";
                                    color: Palette.text-muted;
                                    font-family: Palette.font-body;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                                HorizontalLayout {
                                    spacing: 18px;
                                    SmithRadio {
                                        text: "Off (recommended)";
                                        selected: !root.welcome-telemetry-enabled;
                                        picked => { root.welcome-telemetry-enabled = false; }
                                    }
                                    SmithRadio {
                                        text: "On";
                                        selected: root.welcome-telemetry-enabled;
                                        picked => { root.welcome-telemetry-enabled = true; }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    // Explicit Skip (P4): visually distinct (ghost/secondary)
                    // from the primary "Get started" — closes the wizard
                    // without insisting you touched every card above, but
                    // still records whatever telemetry choice is currently
                    // selected (the safe off-default if you never touched it).
                    SmithButton {
                        text: "Skip for now";
                        kind: "ghost";
                        width: 130px;
                        clicked => { root.welcome-skip(); }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    SmithButton {
                        text: "Get started";
                        kind: "primary";
                        width: 160px;
                        clicked => { root.welcome-finish(); }
                    }
                }
            }
        }
    }
}

// The Windows notification-area presence. A `SystemTrayIcon`-rooted component
// is a *separate* top-level component from `MainWindow` (it has no window of
// its own, shares no globals with MainWindow) — its Rust struct is
// constructed and wired independently; see `src/tray.rs`.
//
// Using Slint's own native tray (vs. a third-party crate) matters beyond
// dependency choice: a visible `SystemTrayIcon` holds one of Slint's internal
// event-loop "keepalive" tokens, the same way a visible `Window` does, so the
// app now correctly keeps running (and the icon stays put) after the main
// window is closed — closing to tray only truly quits via this menu's Quit.
export component SmithTray inherits SystemTrayIcon {
    icon: @image-url("../assets/icon-256.png");
    tooltip: "Smith — local-first AI";

    // Left-click: same as picking "Open" from the menu.
    callback open();
    callback open-settings();
    callback quit();
    clicked => { root.open(); }

    Menu {
        MenuItem {
            title: "Open";
            activated => { root.open(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Settings";
            activated => { root.open-settings(); }
        }
        MenuItem {
            title: "Quit";
            activated => { root.quit(); }
        }
    }
}
